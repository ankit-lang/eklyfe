{% stylesheet %}
  .site-footer {
    background: #f7f7f5;
    color: #232323;
    padding: 4rem 5% 2rem;
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }
  .site-footer__tagline {
    max-width: 920px;
    margin: 0 auto 2.5rem;
    text-align: center;
  }
  .site-footer__tagline p {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #111;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(190px, 1fr));
    gap: 2.5rem;
    margin-bottom: 2.5rem;
  }
  .site-footer__column {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .site-footer__brand-title {
    margin: 0;
    font-size: 1.7rem;
    font-weight: 900;
    letter-spacing: 0.03em;
    color: #0f1f2b;
  }
  .site-footer__brand-subtitle {
    margin: 0;
    color: #4b5563;
    font-weight: 500;
  }
  .site-footer__heading {
    margin: 0;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #0f1f2b;
    font-weight: 800;
  }
  .site-footer__info-list,
  .site-footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .site-footer__info-list li,
  .site-footer__links li {
    font-size: 0.95rem;
    color: #4b5563;
    line-height: 1.7;
  }
  .site-footer__links a,
  .site-footer__brand a,
  .site-footer__social a {
    color: #0f1f2b;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .site-footer__links a:hover,
  .site-footer__brand a:hover,
  .site-footer__social a:hover {
    color: #d97706;
  }
  .site-footer__social {
    display: grid;
    gap: 0.6rem;
    margin-top: 0.8rem;
  }
  .site-footer__social span {
    font-size: 0.95rem;
    color: #4b5563;
  }

  .site-footer__bottom {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    border-top: 1px solid #d9d9d5;
    padding-top: 1.5rem;
    align-items: start;
  }
  .site-footer__copyright {
    font-size: 0.95rem;
    color: #374151;
    font-weight: 600;
  }
  .site-footer__disclaimer {
    font-size: 0.78rem;
    color: #6b7280;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(180px, 1fr));
    }
  }

  @media (max-width: 640px) {
    .site-footer {
      padding: 3rem 4vw 2rem;
    }
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
    .site-footer__tagline p {
      font-size: 1.1rem;
    }
    .site-footer__bottom {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

