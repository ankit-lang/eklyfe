

<div class="apple-carousel-wrapper fade-up-element" style="background-color: {{ section.settings.bg_color }};">
  {% if section.settings.title != blank %}
    <h2 class="apple-carousel-title">{{ section.settings.title }}</h2>
  {% endif %}
  
  <div class="apple-carousel">
    <div class="apple-carousel__track" id="appleCarouselTrack">
      {% for block in section.blocks %}
        <div class="apple-carousel__slide" {{ block.shopify_attributes }}>
          <div class="apple-carousel__content">
            <h3 class="apple-carousel__heading" style="color: {{ block.settings.text_color }}">{{ block.settings.heading }}</h3>
            {% if block.settings.subheading != blank %}
              <p class="apple-carousel__subheading" style="color: {{ block.settings.text_color }}">{{ block.settings.subheading }}</p>
            {% endif %}
            {% if block.settings.button_label != blank %}
              <a href="{{ block.settings.button_link }}" class="apple-carousel__button" style="color: {{ block.settings.text_color }}">{{ block.settings.button_label }}</a>
            {% endif %}
          </div>
          <div class="apple-carousel__image-wrapper">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 800 | image_tag: class: 'apple-carousel__image' }}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'apple-carousel__image placeholder' }}
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('appleCarouselTrack');
    let isDown = false;
    let startX;
    let scrollLeft;

    if(track) {
      track.addEventListener('mousedown', (e) => {
        isDown = true;
        track.classList.add('active');
        startX = e.pageX - track.offsetLeft;
        scrollLeft = track.scrollLeft;
      });
      track.addEventListener('mouseleave', () => {
        isDown = false;
        track.classList.remove('active');
      });
      track.addEventListener('mouseup', () => {
        isDown = false;
        track.classList.remove('active');
      });
      track.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - track.offsetLeft;
        const walk = (x - startX) * 2; // Scroll-fast
        track.scrollLeft = scrollLeft - walk;
      });
    }
  });
</script>

{% stylesheet %}
  .apple-carousel-wrapper {
    padding: 6rem 0;
    overflow: hidden;
  }
  .apple-carousel-title {
    text-align: center;
    font-size: 2.5rem;
    font-weight: 800;
    color: #111;
    margin-bottom: 3rem;
    letter-spacing: -0.5px;
  }
  .apple-carousel {
    width: 100%;
    padding: 0 5%;
  }
  .apple-carousel__track {
    display: flex;
    gap: 2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 2rem;
    /* Hide scrollbar */
    scrollbar-width: none; 
    -ms-overflow-style: none;
  }
  .apple-carousel__track::-webkit-scrollbar {
    display: none; 
  }
  .apple-carousel__track.active {
    scroll-snap-type: none;
    cursor: grabbing;
  }
  .apple-carousel__slide {
    flex: 0 0 70%;
    max-width: 800px;
    height: 500px;
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    scroll-snap-align: center;
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
    cursor: grab;
  }
  .apple-carousel__slide:hover {
    transform: scale(1.02);
    box-shadow: 0 30px 60px rgba(0,0,0,0.15);
  }
  .apple-carousel__image-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    background: #000;
  }
  .apple-carousel__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8;
    transition: transform 0.8s ease;
  }
  .apple-carousel__slide:hover .apple-carousel__image {
    transform: scale(1.05);
  }
  .apple-carousel__content {
    position: absolute;
    top: 3rem;
    left: 3rem;
    z-index: 2;
    max-width: 80%;
  }
  .apple-carousel__heading {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    line-height: 1.1;
  }
  .apple-carousel__subheading {
    font-size: 1.2rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
    opacity: 0.9;
  }
  .apple-carousel__button {
    display: inline-block;
    font-weight: 700;
    text-decoration: none;
    font-size: 1.1rem;
    padding-bottom: 4px;
    border-bottom: 2px solid currentColor;
    transition: opacity 0.3s;
  }
  .apple-carousel__button:hover {
    opacity: 0.7;
  }
  
  @media screen and (max-width: 768px) {
    .apple-carousel__slide {
      flex: 0 0 85%;
      height: 400px;
    }
    .apple-carousel__content {
      top: 2rem;
      left: 2rem;
    }
    .apple-carousel__heading {
      font-size: 1.8rem;
    }
  }
{% endstylesheet %}

