{% comment %}
  Testimonials carousel section.
  Converts the discovery carousel into a horizontal, touch-scrollable testimonial showcase.
{% endcomment %}

<section class="apple-carousel-wrapper fade-up-element" style="background-color: {{ section.settings.bg_color }};">
  {% if section.settings.title != blank %}
    <div class="apple-carousel-headline text-center mb-12">
      <p class="apple-carousel-eyebrow text-gold uppercase tracking-[0.32em] text-sm font-semibold mb-3">Testimonials</p>
      <h2 class="apple-carousel-title">{{ section.settings.title }}</h2>
    </div>
  {% endif %}

  <div class="apple-carousel">
    <div class="apple-carousel__track" id="appleCarouselTrack">
      {% for block in section.blocks %}
        <article class="apple-carousel__slide" {{ block.shopify_attributes }}>
          <div class="apple-carousel__content">
            <p class="testimonial-quote">“{{ block.settings.quote }}”</p>
            <p class="testimonial-author">— {{ block.settings.author }}</p>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const track = document.getElementById('appleCarouselTrack');
    let isDown = false;
    let startX;
    let scrollLeft;

    if (track) {
      track.addEventListener('mousedown', function(e) {
        isDown = true;
        track.classList.add('active');
        startX = e.pageX - track.offsetLeft;
        scrollLeft = track.scrollLeft;
      });

      track.addEventListener('mouseleave', function() {
        isDown = false;
        track.classList.remove('active');
      });

      track.addEventListener('mouseup', function() {
        isDown = false;
        track.classList.remove('active');
      });

      track.addEventListener('mousemove', function(e) {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - track.offsetLeft;
        const walk = (x - startX) * 2;
        track.scrollLeft = scrollLeft - walk;
      });
    }

    if (window.gsap && window.ScrollTrigger) {
      gsap.registerPlugin(ScrollTrigger);
      gsap.utils.toArray('.apple-carousel__slide').forEach(function(card, i) {
        gsap.fromTo(card, {
          opacity: 0,
          y: 40,
          scale: 0.98
        }, {
          opacity: 1,
          y: 0,
          scale: 1,
          duration: 0.9,
          delay: i * 0.12,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: card,
            start: 'top 95%',
          }
        });
      });
    }
  });
</script>

{% stylesheet %}
  .apple-carousel-wrapper {
    padding: 6rem 0;
    overflow: hidden;
    position: relative;
  }

  .apple-carousel-headline {
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }

  .apple-carousel-eyebrow {
    color: #c9a84c;
  }

  .apple-carousel-title {
    font-size: clamp(2.25rem, 3.5vw, 3.75rem);
    font-weight: 800;
    color: #111827;
    margin: 0;
    line-height: 1.02;
  }

  .apple-carousel {
    width: 100%;
    padding: 0 1.5rem;
  }

  .apple-carousel__track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 1rem;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .apple-carousel__track::-webkit-scrollbar {
    display: none;
  }

  .apple-carousel__track.active {
    cursor: grabbing;
  }

  .apple-carousel__slide {
    scroll-snap-align: start;
    flex: 0 0 min(85%, 560px);
    min-width: 320px;
    background: #ffffff;
    border: 1px solid rgba(17,24,39,0.08);
    border-radius: 2rem;
    padding: 2.2rem;
    box-shadow: 0 24px 60px rgba(15,23,42,0.08);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }

  .apple-carousel__slide:hover {
    transform: translateY(-6px);
    box-shadow: 0 32px 80px rgba(15,23,42,0.12);
  }

  .testimonial-quote {
    margin: 0 0 1.5rem;
    color: #111827;
    font-size: 1rem;
    line-height: 1.85;
    font-weight: 400;
  }

  .testimonial-author {
    margin: 0;
    color: #0f172a;
    font-size: 0.95rem;
    font-weight: 700;
  }

  @media (min-width: 768px) {
    .apple-carousel__slide {
      flex: 0 0 42%;
      min-width: 420px;
    }
  }

  @media (min-width: 1200px) {
    .apple-carousel__slide {
      flex: 0 0 32%;
      min-width: 320px;
    }
  }

  .text-gold { color: #c9a84c; }
{% endstylesheet %}

{% schema %}

{
  "name": "Testimonials Carousel",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Real People. Real Results."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f9f5ee"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Testimonial",
      "settings": [
        {
          "type": "text",
          "id": "quote",
          "label": "Quote",
          "default": "The Pre Menopause Support has been life-changing. Two months in and my mood swings have eased, my sleep is better, and I feel like myself again."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Priya S., 47, Delhi"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials Carousel",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
