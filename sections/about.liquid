  <!-- ══════════════════════════════════════════
       FOOTER STAMP
  ══════════════════════════════════════════ -->
  <div class="bg-cream border-t border-border py-16 text-center overflow-hidden">
    <p class="font-display font-bold text-green tracking-[0.12em] uppercase" style="font-size: clamp(24px,5vw,60px);" data-aos="fade-up">
      Towards a Better You
    </p>
