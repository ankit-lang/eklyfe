  <!-- ══════════════════════════════════════════
       SCRIPTS
  ══════════════════════════════════════════ -->
  <script>

    /* ── Lenis smooth scroll ── */
    const lenis = new Lenis({ lerp: 0.07, smoothWheel: true });
    function raf(time) { lenis.raf(time); requestAnimationFrame(raf); }
    requestAnimationFrame(raf);
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((time) => { lenis.raf(time * 1000); });
    gsap.ticker.lagSmoothing(0);

    /* ── Scroll progress bar ── */
    window.addEventListener('scroll', () => {
      const pct = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
      document.getElementById('progress-bar').style.width = pct + '%';
    });

    /* ── Custom cursor ── */
    const cursor = document.getElementById('cursor');
    const ring   = document.getElementById('cursor-ring');
    let mx = 0, my = 0, rx = 0, ry = 0;
    document.addEventListener('mousemove', e => { mx = e.clientX; my = e.clientY; });
    (function animCursor() {
      cursor.style.left = mx + 'px';
      cursor.style.top  = my + 'px';
      rx += (mx - rx) * 0.12;
      ry += (my - ry) * 0.12;
      ring.style.left = rx + 'px';
      ring.style.top  = ry + 'px';
      requestAnimationFrame(animCursor);
    })();
    document.querySelectorAll('a,button').forEach(el => {
      el.addEventListener('mouseenter', () => {
        cursor.style.width = '20px'; cursor.style.height = '20px';
        ring.style.width = '60px';  ring.style.height = '60px';
      });
      el.addEventListener('mouseleave', () => {
        cursor.style.width = '12px'; cursor.style.height = '12px';
        ring.style.width = '40px';  ring.style.height = '40px';
      });
    });

    /* ── Hero entrance (GSAP) ── */
    const heroTl = gsap.timeline({ delay: 0.3 });
    heroTl
      .to('#hero-eyebrow', { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' }, 0)
      .to('#hero-title',   { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out' }, 0.2)
      .to('#hero-quote',   { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out' }, 0.5)
      .to('#scroll-hint',  { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, 0.9);

    /* ── Hero title parallax ── */
    gsap.to('#hero-title', {
      y: -60,
      ease: 'none',
      scrollTrigger: { trigger: 'body', start: 'top top', end: '30% top', scrub: true }
    });

    /* ── GSAP: section headings slide-in from left ── */
    gsap.utils.toArray('.font-display.font-bold').forEach(el => {
      if (el.closest('.os-hero')) return;
      gsap.from(el, {
        x: -40, opacity: 0, duration: 0.9, ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 85%', toggleActions: 'play none none none' }
      });
    });

    /* ── GSAP: diff cards stagger ── */
    gsap.from('.card-lift', {
      y: 40, opacity: 0, stagger: 0.08, duration: 0.7, ease: 'power2.out',
      scrollTrigger: { trigger: '.card-lift', start: 'top 85%', toggleActions: 'play none none none' }
    });

    /* ── GSAP: core difference panel reveal ── */
    const differenceSection = document.querySelector('.difference-card');
    if (differenceSection) {
      gsap.from(differenceSection, {
        opacity: 0,
        y: 40,
        duration: 1,
        ease: 'power3.out',
        scrollTrigger: { trigger: differenceSection, start: 'top 90%', toggleActions: 'play none none none' }
      });
    }

    const detailTitle = document.getElementById('difference-detail-title');
    const detailCopy = document.getElementById('difference-detail-copy');
    const diffButtons = document.querySelectorAll('.difference-pill');

    const details = [
      "Every formula begins with lived experience, not theory. Our founder built eklyfe from the real challenges of modern health and the promise of Ayurvedic renewal.",
      "We combine time-tested Ayurvedic wisdom with clinical validation so each product can perform reliably in today's world.",
      "Our range supports both men and women with thoughtfully balanced formulas for every life phase.",
      "We use clinical-strength doses, not tracer amounts. Every ingredient is chosen to make a meaningful difference.",
      "Every product is 100% vegan, with no artificial additives, colours, or preservatives — just clean wellness.",
      "We never hide behind proprietary blends. Every ingredient and dose is listed clearly so you can make informed choices."
    ];

    diffButtons.forEach((button, idx) => {
      button.addEventListener('click', () => {
        diffButtons.forEach(btn => btn.classList.remove('active'));
        button.classList.add('active');
        if (detailTitle && detailCopy) {
          detailTitle.textContent = button.querySelector('.difference-title').textContent;
          detailCopy.textContent = details[idx];
        }
      });
    });

    if (diffButtons.length) {
      diffButtons[0].classList.add('active');
      if (detailTitle && detailCopy) {
        detailTitle.textContent = diffButtons[0].querySelector('.difference-title').textContent;
        detailCopy.textContent = details[0];
      }
    }

    /* ── AOS init ── */
    AOS.init({ once: true, offset: 80, easing: 'ease-out-cubic' });

    /* ── Marquee: duplicate content for seamless loop ── */
    const marqueeTrack = document.querySelector('.marquee-track');
    const tmpl = document.getElementById('marquee-item');
    if (tmpl && marqueeTrack) {
      const clone1 = tmpl.content.cloneNode(true);
      const clone2 = tmpl.content.cloneNode(true);
      marqueeTrack.appendChild(clone1);
      marqueeTrack.appendChild(clone2);
      // double it for seamless
      marqueeTrack.innerHTML += marqueeTrack.innerHTML;
    }

    /* ── Floating leaf particles in hero ── */
    const heroParticles = document.getElementById('hero-particles');
    for (let i = 0; i < 18; i++) {
      const dot = document.createElement('div');
      dot.className = 'leaf-particle';
      dot.style.cssText = `
        left: ${Math.random()*100}%;
        top: ${Math.random()*100}%;
        width: ${4 + Math.random()*8}px;
        height: ${4 + Math.random()*8}px;
        animation-delay: ${Math.random()*6}s;
        animation-duration: ${5 + Math.random()*5}s;
        opacity: ${0.1 + Math.random()*0.25};
        background: rgba(107,143,78,${0.2 + Math.random()*0.3});
      `;
      heroParticles.appendChild(dot);
    }

    /* ── Underline reveal on scroll ── */
    const underlines = document.querySelectorAll('.highlight-underline');
    const uObs = new IntersectionObserver(entries => {
      entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('is-visible'); });
    }, { threshold: 0.5 });
    underlines.forEach(el => uObs.observe(el));

    /* ── Number counter for stat ── */
    const statNum = document.querySelector('#stat-counter');
    if (statNum) {
      const obj = { val: 0 };
      ScrollTrigger.create({
        trigger: statNum,
        start: 'top 90%',
        once: true,
        onEnter: () => {
          gsap.to(obj, {
            val: 100,
            duration: 1.4,
            ease: 'power2.out',
            onUpdate: () => {
              const v = Math.floor(obj.val);
              statNum.textContent = v < 100 ? v + 'K+' : '1 Lakh+';
            },
            onComplete: () => { statNum.textContent = '1 Lakh+'; }
          });
        }
      });
    }

  </script>
</body>
</html>