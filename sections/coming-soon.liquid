<div class="coming-soon-wrapper">
  <div class="coming-soon-content">
    <h1 class="coming-soon-title">GREAT THINGS ARE ON THE HORIZON</h1>
    <p class="coming-soon-subtitle">Something big is brewing! Our store is in the works and will be launching soon!</p>
  </div>
</div>

{% stylesheet %}
  .coming-soon-wrapper {
    background-color: #f6f5ef;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 5%;
  }

  .coming-soon-content {
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .coming-soon-title {
    font-family: "Times New Roman", Times, serif;
    font-size: clamp(3rem, 7vw, 6.5rem);
    font-weight: 400;
    line-height: 1.1;
    color: #111;
    margin: 0 0 2rem;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .coming-soon-subtitle {
    font-family: "Inter", "Helvetica Neue", Arial, sans-serif;
    font-size: 1.1rem;
    font-weight: 400;
    color: #555;
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .coming-soon-title {
      font-size: 2.5rem;
      margin-bottom: 1.5rem;
    }
    .coming-soon-subtitle {
      font-size: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Coming Soon",
  "settings": []
}
{% endschema %}
