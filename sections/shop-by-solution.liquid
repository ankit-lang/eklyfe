<section class="sbs-section" style="background: {{ section.settings.bg_color | default: '#f9f9f5' }};">
  <div class="sbs-section__inner">
    <div class="sbs-section__head">
      <h2 class="sbs-title">{{ section.settings.heading | default: 'SHOP BY SOLUTION' }}</h2>
      <div class="sbs-flourish">
        <svg width="300" height="50" viewBox="0 0 300 50" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Left line with curl and middle dip -->
          <path d="M 25,18 C 20,22 15,18 18,13 C 21,9 27,11 28,15 L 135,15 C 142,15 145,18 147,21" stroke="#7acc56" stroke-width="2" fill="none" stroke-linecap="round"/>
          
          <!-- Right line with curl and middle dip -->
          <path d="M 275,18 C 280,22 285,18 282,13 C 279,9 273,11 272,15 L 165,15 C 158,15 155,18 153,21" stroke="#7acc56" stroke-width="2" fill="none" stroke-linecap="round"/>

          <!-- Center Downward Leaf -->
          <path d="M150,18 C155,28 158,35 150,45 C142,35 145,28 150,18 Z" fill="#7acc56"/>

          <!-- Left Ornate Leaf -->
          <path d="M148,22 C135,15 115,22 125,35 C129,40 135,36 131,31 C128,26 135,24 144,28 Z" fill="#7acc56"/>

          <!-- Right Ornate Leaf -->
          <path d="M152,22 C165,15 185,22 175,35 C171,40 165,36 169,31 C172,26 165,24 156,28 Z" fill="#7acc56"/>
        </svg>
      </div>
    </div>

    <div class="sbs-grid">
      {% for block in section.blocks %}
        {% assign collection = block.settings.collection %}
        {% assign card_url = collection.url | default: '#' %}
        {% assign title = collection.title | default: 'Collection Name' %}
        {% assign products_count = collection.products_count | default: 0 %}
        
        <a href="{{ card_url }}" class="sbs-card" {{ block.shopify_attributes }}>
          <div class="sbs-card__image-wrapper" style="background-color: {{ block.settings.bg_color }};">
            {% assign card_image = collection.featured_image | default: block.settings.fallback_image %}
            {% if card_image != blank %}
              {{ card_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'sbs-card__img' }}
            {% else %}
              <img src="{{ '1.jpeg' | asset_url }}" alt="{{ title }}" class="sbs-card__img" loading="lazy">
            {% endif %}
          </div>
          
          <div class="sbs-card__content-box">
            <h3 class="sbs-card__title">{{ title | upcase }}</h3>
            <p class="sbs-card__sub">{{ products_count }} PRODUCTS</p>
          </div>
        </a>
      {% else %}
        {% for i in (1..4) %}
          <a href="#" class="sbs-card">
            <div class="sbs-card__image-wrapper" style="background-color: #2781d4;">
              <img src="{{ '1.jpeg' | asset_url }}" alt="Placeholder" class="sbs-card__img" loading="lazy">
            </div>
            <div class="sbs-card__content-box">
              <h3 class="sbs-card__title">CATEGORY {{ i }}</h3>
              <p class="sbs-card__sub">0 PRODUCTS</p>
            </div>
          </a>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .sbs-section {
    padding: 5rem 5%;
    position: relative;
    background: #f9f9f5;
  }
  .sbs-section__inner { max-width: 1300px; margin: 0 auto; }
  
  .sbs-section__head { 
    text-align: center; 
    margin-bottom: 3.5rem; 
  }
  .sbs-title {
    font-size: clamp(2rem, 3.5vw, 2.5rem);
    font-weight: 500;
    color: #000;
    letter-spacing: 1px;
    margin: 0;
    text-transform: uppercase;
  }
  .sbs-flourish {
    margin-top: -10px;
    display: flex;
    justify-content: center;
  }
  
  .sbs-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  
  .sbs-card {
    position: relative;
    text-decoration: none;
    display: block;
    background: #fff;
    padding: 8px;
    border: 1px solid #ddd;
    border-radius: 8px; /* Rounded corners as requested */
    box-shadow: 0 4px 15px rgba(0,0,0,0.05); /* Soft shadow */
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .sbs-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
  }
  
  .sbs-card__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }
  .sbs-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    mix-blend-mode: multiply;
    transition: transform 0.4s ease;
  }
  .sbs-card:hover .sbs-card__img {
    transform: scale(1.08); /* Slight zoom on hover */
  }
  
  .sbs-card__content-box {
    position: absolute;
    bottom: 25px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(255, 255, 255, 0.9); /* Semi-transparent overlay box */
    padding: 12px 10px;
    width: 85%;
    text-align: center;
    box-shadow: 0 5px 15px rgba(0,0,0,0.08);
    transition: background 0.3s ease, box-shadow 0.3s ease;
    border-radius: 4px;
  }
  .sbs-card:hover .sbs-card__content-box {
    background: rgba(255, 255, 255, 1); /* Becomes more visible on hover */
    box-shadow: 0 8px 20px rgba(0,0,0,0.12);
  }
  
  .sbs-card__title {
    font-size: 0.9rem;
    font-weight: 800;
    color: #000;
    margin: 0 0 4px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  .sbs-card__sub {
    font-size: 0.75rem;
    font-weight: 600;
    color: #666;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* Responsive Grid */
  @media screen and (max-width: 990px) { 
    .sbs-grid { grid-template-columns: repeat(2, 1fr); gap: 1.5rem; } 
  }
  @media screen and (max-width: 500px) {
    .sbs-grid { grid-template-columns: 1fr; }
    .sbs-section { padding: 4rem 5%; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop By Solution",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP BY SOLUTION"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#f9f9f5"
    }
  ],
  "blocks": [
    {
      "type": "collection_block",
      "name": "Collection Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "image_picker",
          "id": "fallback_image",
          "label": "Fallback Image (If collection image is missing)"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Image Background Color",
          "default": "#2781d4"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop By Solution",
      "blocks": [
        { "type": "collection_block", "settings": { "bg_color": "#2781d4" } },
        { "type": "collection_block", "settings": { "bg_color": "#fcb900" } },
        { "type": "collection_block", "settings": { "bg_color": "#79dbec" } },
        { "type": "collection_block", "settings": { "bg_color": "#fca4b7" } }
      ]
    }
  ]
}
{% endschema %}
