<div class="wc-section" style="background: {{ section.settings.bg_color }};">
  <div class="wc-section__inner">
    <div class="wc-section__head">
      <span class="wc-section__eyebrow">EXPLORE THE RANGE</span>
      <h2 class="wc-section__title">{{ section.settings.heading | default: 'Shop By Category' }}</h2>
      <p class="wc-section__subtitle">{{ section.settings.subtitle | default: 'Targeted wellness formulas for every aspect of your health' }}</p>
    </div>

    <div class="wc-grid">
      {% for block in section.blocks %}
        {% assign is_coming_soon = block.settings.coming_soon %}
        <a
          href="{% unless is_coming_soon %}{{ block.settings.link }}{% else %}#{% endunless %}"
          class="wc-card wc-card--{{ block.settings.accent_color | default: 'green' }} {% if is_coming_soon %}wc-card--soon{% endif %}"
          style="--card-bg: {{ block.settings.card_bg | default: '#f4f9f7' }}; --card-accent: {{ block.settings.accent_hex | default: '#1a4f44' }};"
          {% if is_coming_soon %}aria-disabled="true" tabindex="-1"{% endif %}
        >
          <div class="wc-card__glow"></div>

          <div class="wc-card__icon-wrap">
            {% if block.settings.icon != blank %}
              {{ block.settings.icon | image_url: width: 80 | image_tag: loading: 'lazy', class: 'wc-card__icon-img' }}
            {% else %}
              <div class="wc-card__icon-emoji">{{ block.settings.emoji | default: '🌿' }}</div>
            {% endif %}
          </div>

          <div class="wc-card__body">
            <h3 class="wc-card__title">{{ block.settings.title }}</h3>
            {% if block.settings.description != blank %}
              <p class="wc-card__desc">{{ block.settings.description }}</p>
            {% endif %}
          </div>

          {% if is_coming_soon %}
            <div class="wc-card__soon-badge">COMING SOON</div>
          {% else %}
            <div class="wc-card__arrow">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
          {% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .wc-section {
    padding: 6rem 5%;
    position: relative;
    overflow: hidden;
  }
  .wc-section::before {
    content: '';
    position: absolute;
    top: -200px;
    right: -200px;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(244,127,32,0.06) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }
  .wc-section__inner {
    max-width: 1400px;
    margin: 0 auto;
  }
  .wc-section__head {
    text-align: center;
    margin-bottom: 4rem;
  }
  .wc-section__eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 4px;
    color: #f47f20;
    text-transform: uppercase;
    margin-bottom: 1rem;
    padding: 6px 18px;
    background: rgba(244,127,32,0.1);
    border-radius: 100px;
  }
  .wc-section__title {
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    font-weight: 900;
    color: #111;
    letter-spacing: -2px;
    line-height: 1.08;
    margin: 0 0 1rem;
  }
  .wc-section__subtitle {
    font-size: 1.1rem;
    color: #666;
    max-width: 540px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* ── Grid ── */
  .wc-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  /* ── Card base ── */
  .wc-card {
    position: relative;
    background: var(--card-bg, #f4f9f7);
    border-radius: 20px;
    padding: 2rem 1.75rem;
    text-decoration: none;
    color: #111;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border: 1.5px solid transparent;
    transition: transform 0.35s cubic-bezier(0.16,1,0.3,1),
                box-shadow 0.35s cubic-bezier(0.16,1,0.3,1),
                border-color 0.3s;
    cursor: pointer;
  }
  .wc-card:not(.wc-card--soon):hover {
    transform: translateY(-8px) scale(1.01);
    box-shadow: 0 24px 60px rgba(0,0,0,0.12);
    border-color: var(--card-accent);
  }
  .wc-card--soon {
    cursor: default;
    opacity: 0.75;
  }

  /* Glow orb */
  .wc-card__glow {
    position: absolute;
    top: -40px;
    right: -40px;
    width: 140px;
    height: 140px;
    background: radial-gradient(circle, var(--card-accent, #1a4f44), transparent 70%);
    opacity: 0.08;
    border-radius: 50%;
    transition: opacity 0.4s;
    pointer-events: none;
  }
  .wc-card:not(.wc-card--soon):hover .wc-card__glow {
    opacity: 0.18;
  }

  /* Icon */
  .wc-card__icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    background: rgba(255,255,255,0.9);
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.3s;
  }
  .wc-card:not(.wc-card--soon):hover .wc-card__icon-wrap {
    transform: scale(1.1) rotate(-5deg);
  }
  .wc-card__icon-emoji {
    font-size: 2rem;
    line-height: 1;
  }
  .wc-card__icon-img {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  /* Text */
  .wc-card__body {
    flex: 1;
  }
  .wc-card__title {
    font-size: 1.05rem;
    font-weight: 800;
    color: #111;
    margin: 0 0 0.4rem;
    line-height: 1.3;
  }
  .wc-card__desc {
    font-size: 0.85rem;
    color: #666;
    line-height: 1.6;
    margin: 0;
  }

  /* Arrow */
  .wc-card__arrow {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--card-accent, #1a4f44);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: flex-end;
    transition: transform 0.3s, background 0.3s;
    flex-shrink: 0;
  }
  .wc-card:not(.wc-card--soon):hover .wc-card__arrow {
    transform: translate(4px, -4px);
    background: #f47f20;
  }

  /* Coming Soon badge */
  .wc-card__soon-badge {
    position: absolute;
    top: 14px;
    right: 14px;
    background: linear-gradient(135deg, #f47f20, #e55c00);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 2px;
    padding: 5px 12px;
    border-radius: 100px;
    text-transform: uppercase;
    box-shadow: 0 4px 12px rgba(244,127,32,0.4);
    animation: pulseGlow 2s ease-in-out infinite;
  }
  @keyframes pulseGlow {
    0%, 100% { box-shadow: 0 4px 12px rgba(244,127,32,0.4); }
    50% { box-shadow: 0 4px 20px rgba(244,127,32,0.7); }
  }

  /* ── Responsive ── */
  @media screen and (max-width: 1200px) {
    .wc-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media screen and (max-width: 900px) {
    .wc-grid { grid-template-columns: repeat(2, 1fr); }
    .wc-section { padding: 4rem 5%; }
  }
  @media screen and (max-width: 480px) {
    .wc-grid { grid-template-columns: 1fr 1fr; gap: 0.85rem; }
    .wc-card { padding: 1.5rem 1.25rem; }
    .wc-section__title { letter-spacing: -1px; }
  }
{% endstylesheet %}

