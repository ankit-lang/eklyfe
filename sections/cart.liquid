<div class="cart-page">
  <div class="cart-header">
    <h1 class="cart-title">Your Cart</h1>
    <a href="{{ routes.all_products_collection_url }}" class="continue-shopping">Continue Shopping</a>
  </div>

  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" class="cart-form">
      <div class="cart-layout">
        <div class="cart-items">
          {% for item in cart.items %}
            <div class="cart-item">
              <div class="cart-item__image-container">
                <a href="{{ item.url }}">
                  {% if item.image %}
                    {{ item.image | image_url: width: 300 | image_tag: class: 'cart-item__image' }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'cart-item__image placeholder' }}
                  {% endif %}
                </a>
              </div>
              
              <div class="cart-item__details">
                <div class="cart-item__info">
                  <h3 class="cart-item__title">
                    <a href="{{ item.url }}">{{ item.product.title }}</a>
                  </h3>
                  {% unless item.product.has_only_default_variant %}
                    <p class="cart-item__variant">{{ item.variant.title }}</p>
                  {% endunless %}
                  <div class="cart-item__price">{{ item.final_price | money }}</div>
                </div>

                <div class="cart-item__actions">
                  <div class="quantity-selector">
                    <input type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0" class="quantity-input">
                  </div>
                  
                  <a href="{{ item.url_to_remove }}" class="cart-item__remove">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                  </a>
                </div>
              </div>
            </div>
          {% endfor %}
          <div class="cart-update-wrapper">
            <button type="submit" name="update" class="cart-update-btn">Update Cart</button>
          </div>
        </div>

        <div class="cart-summary">
          <div class="cart-summary__box">
            <h2 class="cart-summary__title">Order Summary</h2>
            
            <div class="cart-summary__row">
              <span>Subtotal</span>
              <span class="cart-summary__subtotal">{{ cart.total_price | money }}</span>
            </div>
            
            <p class="cart-summary__note">Taxes and shipping calculated at checkout</p>
            
            <button type="submit" name="checkout" class="cart-checkout-btn">
              Proceed to Checkout
            </button>
          </div>
        </div>
      </div>
    </form>
  {% else %}
    <div class="cart-empty">
      <div class="cart-empty__icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
      </div>
      <h2>Your cart is currently empty.</h2>
      <a href="{{ routes.all_products_collection_url }}" class="cart-empty__btn">Start Shopping</a>
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .cart-page {
    max-width: 1200px;
    margin: 4rem auto;
    padding: 0 5%;
    animation: fadeIn 0.8s ease-out;
  }
  
  .cart-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3rem;
    border-bottom: 2px solid #e0e0e0;
    padding-bottom: 1rem;
  }
  
  .cart-title {
    font-size: 2.5rem;
    color: #1a4f44;
    font-weight: 900;
    margin: 0;
  }
  
  .continue-shopping {
    color: #f47f20;
    text-decoration: none;
    font-weight: bold;
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 1px;
    transition: color 0.3s;
  }
  
  .continue-shopping:hover {
    color: #d16b18;
  }
  
  .cart-layout {
    display: flex;
    gap: 3rem;
    align-items: flex-start;
  }
  
  .cart-items {
    flex: 2;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  
  .cart-item {
    display: flex;
    gap: 2rem;
    background: #fff;
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    transition: transform 0.3s, box-shadow 0.3s;
    animation: slideUp 0.5s ease-out forwards;
    opacity: 0;
  }
  
  .cart-item:nth-child(1) { animation-delay: 0.1s; }
  .cart-item:nth-child(2) { animation-delay: 0.2s; }
  .cart-item:nth-child(3) { animation-delay: 0.3s; }
  
  .cart-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.08);
  }
  
  .cart-item__image-container {
    width: 120px;
    height: 120px;
    border-radius: 8px;
    overflow: hidden;
    background: #f9f9f9;
    flex-shrink: 0;
  }
  
  .cart-item__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  
  .cart-item__details {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .cart-item__info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .cart-item__title a {
    text-decoration: none;
    color: #333;
    font-size: 1.2rem;
    font-weight: bold;
    transition: color 0.3s;
  }
  
  .cart-item__title a:hover {
    color: #1a4f44;
  }
  
  .cart-item__variant {
    color: #888;
    font-size: 0.9rem;
    margin: 0;
  }
  
  .cart-item__price {
    font-size: 1.2rem;
    font-weight: 800;
    color: #1a4f44;
  }
  
  .cart-item__actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  
  .quantity-input {
    width: 60px;
    padding: 8px;
    border: 1px solid #ddd;
    border-radius: 6px;
    text-align: center;
    font-weight: bold;
    color: #333;
    transition: border-color 0.3s;
  }
  
  .quantity-input:focus {
    border-color: #f47f20;
    outline: none;
  }
  
  .cart-item__remove {
    color: #ff4d4f;
    transition: transform 0.2s, color 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    background: #fff1f0;
    border-radius: 50%;
  }
  
  .cart-item__remove:hover {
    transform: scale(1.1) rotate(5deg);
    color: #d9363e;
    background: #ffccc7;
  }
  
  .cart-update-wrapper {
    text-align: right;
    margin-top: 1rem;
  }
  
  .cart-update-btn {
    background: transparent;
    border: 2px solid #1a4f44;
    color: #1a4f44;
    padding: 10px 24px;
    border-radius: 50px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.3s;
  }
  
  .cart-update-btn:hover {
    background: #1a4f44;
    color: #fff;
  }
  
  .cart-summary {
    flex: 1;
    position: sticky;
    top: 100px;
  }
  
  .cart-summary__box {
    background: #f5f7f6;
    padding: 2.5rem;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  }
  
  .cart-summary__title {
    font-size: 1.5rem;
    color: #1a4f44;
    font-weight: 800;
    margin-bottom: 2rem;
    border-bottom: 1px solid #ddd;
    padding-bottom: 1rem;
  }
  
  .cart-summary__row {
    display: flex;
    justify-content: space-between;
    font-size: 1.2rem;
    font-weight: bold;
    color: #333;
    margin-bottom: 1rem;
  }
  
  .cart-summary__subtotal {
    color: #1a4f44;
    font-size: 1.4rem;
  }
  
  .cart-summary__note {
    font-size: 0.85rem;
    color: #666;
    margin-bottom: 2rem;
    text-align: center;
  }
  
  .cart-checkout-btn {
    width: 100%;
    background-color: #f47f20;
    color: white;
    border: none;
    padding: 16px;
    font-size: 1.1rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: 0 8px 20px rgba(244, 127, 32, 0.3);
  }
  
  .cart-checkout-btn:hover {
    background-color: #d16b18;
    transform: translateY(-3px);
    box-shadow: 0 12px 25px rgba(244, 127, 32, 0.4);
  }
  
  .cart-empty {
    text-align: center;
    padding: 5rem 0;
  }
  
  .cart-empty__icon {
    color: #ccc;
    margin-bottom: 2rem;
    animation: float 3s ease-in-out infinite;
  }
  
  .cart-empty h2 {
    color: #1a4f44;
    margin-bottom: 2rem;
  }
  
  .cart-empty__btn {
    display: inline-block;
    background-color: #1a4f44;
    color: #fff;
    padding: 14px 36px;
    text-decoration: none;
    font-weight: bold;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s;
  }
  
  .cart-empty__btn:hover {
    background-color: #123830;
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(26, 79, 68, 0.2);
  }
  
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  @keyframes float {
    0% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
    100% { transform: translateY(0); }
  }
  
  @media (max-width: 768px) {
    .cart-layout {
      flex-direction: column;
    }
    
    .cart-item__details {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
    
    .cart-item__actions {
      width: 100%;
      justify-content: space-between;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
