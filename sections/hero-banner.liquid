<section class="genz-carousel">
  <div class="genz-carousel__track">
    <!-- Slide 1 -->
    <div class="genz-carousel__slide">
      <img src="{{ '1.jpeg' | asset_url }}" class="genz-carousel__bg" alt="Banner 1" loading="eager">
      <div class="genz-carousel__content">
        <div class="genz-badge">🔥 NEW ARRIVALS</div>
        <h1 class="genz-heading">MAIN CHARACTER ENERGY</h1>
        <a href="{{ routes.all_products_collection_url }}" class="genz-btn">EXPLORE</a>
      </div>
    </div>

    <!-- Slide 2 -->
    <div class="genz-carousel__slide">
      <img src="{{ '2.jpeg' | asset_url }}" class="genz-carousel__bg" alt="Banner 2" loading="eager">
      <div class="genz-carousel__content">
        <div class="genz-badge">✨ VIRAL PICKS</div>
        <h1 class="genz-heading">DONT MISS OUT</h1>
        <a href="{{ routes.all_products_collection_url }}" class="genz-btn">SHOP NOW</a>
      </div>
    </div>
  </div>

  <!-- Dots Navigation Indicator -->
  <div class="genz-carousel__nav" aria-hidden="true">
    <div class="carousel-dots">
      <button type="button" class="carousel-dot is-active" aria-label="Go to slide 1" data-index="0"></button>
      <button type="button" class="carousel-dot" aria-label="Go to slide 2" data-index="1"></button>
    </div>
  </div>

  <!-- Left/Right Navigation -->
  <button type="button" class="carousel-nav-btn prev-btn" aria-label="Previous slide">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
  </button>
  <button type="button" class="carousel-nav-btn next-btn" aria-label="Next slide">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
  </button>
</section>

{% stylesheet %}
  .genz-carousel {
    position: relative;
    width: 100%;
    height: 90vh; /* Immersive full viewport height */
    background: #0b0b0b;
    overflow: hidden;
  }
  
  .genz-carousel__track {
    display: flex;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  
  .genz-carousel__track::-webkit-scrollbar { 
    display: none; 
  }
  
  .genz-carousel__slide {
    position: relative;
    flex: 0 0 100%;
    height: 100%;
    scroll-snap-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  
  .genz-carousel__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    filter: brightness(0.65) contrast(1.1); /* Darken bg to make text pop */
    transform: scale(1.05);
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1), filter 0.6s ease;
  }
  
  .placeholder-bg { 
    background: linear-gradient(135deg, #4A00E0, #8E2DE2); 
  }
  
  .genz-carousel__slide:hover .genz-carousel__bg {
    transform: scale(1);
    filter: brightness(0.5) contrast(1.2);
  }
  
  .genz-carousel__content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 2rem;
    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    width: 100%;
    max-width: 1200px;
  }
  
  .genz-badge {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 0.6rem 1.8rem;
    border-radius: 100px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 0.85rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    color: #fff;
  }
  
  .genz-heading {
    font-size: clamp(3.5rem, 12vw, 8.5rem);
    font-weight: 900;
    line-height: 0.85;
    text-transform: uppercase;
    margin: 0;
    /* Brutalist / Cyberpunk Text Outline Effect */
    color: transparent;
    -webkit-text-stroke: 2px rgba(255, 255, 255, 0.9);
    text-shadow: 0px 10px 30px rgba(0,0,0,0.5);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    letter-spacing: -3px;
  }
  
  .genz-carousel__slide:hover .genz-heading {
    color: #fff;
    -webkit-text-stroke: 0px transparent;
    transform: scale(1.05) skew(-3deg);
  }
  
  .genz-btn {
    margin-top: 1.5rem;
    display: inline-block;
    background: #1a4f44; /* High-contrast neon pop */
    color: white;
    font-weight: 900;
    font-size: 1.1rem;
    padding: 1.2rem 3.5rem;
    border-radius: 100px;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 10px 25px rgba(204, 255, 0, 0.25);
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    letter-spacing: 1px;
  }
  
  .genz-btn:hover {
    transform: translateY(-8px) scale(1.05);
    box-shadow: 0 15px 35px rgba(204, 255, 0, 0.4);

  }
  
  .genz-carousel__nav {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
  }
  
  .carousel-dots {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(0, 0, 0, 0.4);
    padding: 10px 20px;
    border-radius: 100px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.1);
  }
  
  .carousel-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }
  
  .carousel-dot:hover {
    background: rgba(255, 255, 255, 0.7);
  }
  
  .carousel-dot.is-active {
    background: #1a4f44; /* Neon pop color matching button */
    transform: scale(1.3);
    box-shadow: 0 0 10px rgba(204, 255, 0, 0.5);
  }
  
  .carousel-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: all 0.3s ease;
  }
  
  .carousel-nav-btn:hover {
    background: #1a4f44;
    color: white;
    transform: translateY(-50%) scale(1.1);
  }
  
  .prev-btn { left: 1rem; }
  .next-btn { right: 1rem; }
  
  /* Mobile adjustments */
  @media screen and (max-width: 768px) {
    .genz-carousel {
      height: 85vh;
    }
    .genz-heading {
      -webkit-text-stroke: 1px rgba(255, 255, 255, 0.9);
      letter-spacing: -1px;
    }
    .genz-btn {
      padding: 1rem 2.5rem;
      font-size: 1rem;
    }
  }
{% endstylesheet %}

