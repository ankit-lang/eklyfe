  </div>

  <!-- Navigation -->
  <button class="carousel-nav-btn prev-btn" aria-label="Previous Slide">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
      <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2"/>
    </svg>
  </button>

  <button class="carousel-nav-btn next-btn" aria-label="Next Slide">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
      <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2"/>
    </svg>
  </button>
</section>

<style>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap');

.premium-carousel {
  position: relative;
  width: 100%;
  height: 88vh;
  overflow: hidden;
  background: #000;
 
}

.premium-carousel__track {
  display: flex;
  width: 100%;
  height: 100%;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}

.premium-carousel__track::-webkit-scrollbar {
  display: none;
}

.premium-carousel__slide {
  position: relative;
  flex: 0 0 100%;
  height: 100%;
  overflow: hidden;
  scroll-snap-align: start;
  display: flex;
  align-items: center;
}

.premium-carousel__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;

  filter:
    brightness(1)
    contrast(1.5)
    saturate(1.05);

  animation: slowZoom 12s ease-in-out infinite alternate;
}

@keyframes slowZoom {
  from {
    transform: scale(1.02);
  }
  to {
    transform: scale(1.08);
  }
}

.premium-carousel__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;

  background:
    linear-gradient(
      90deg,
      rgba(0,0,0,0.72) 0%,
      rgba(0,0,0,0.48) 38%,
      rgba(0,0,0,0.15) 100%
    );
}

.premium-carousel__overlay::after {
  content: "";
  position: absolute;

  width: 700px;
  height: 700px;

  border-radius: 50%;

  background: rgba(47,160,132,0.12);

  filter: blur(120px);

  top: -250px;
  right: -180px;
}

.premium-carousel__content {
  position: relative;
  z-index: 2;

  max-width: 680px;

  padding-left: 8%;
  padding-right: 2rem;

  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.premium-badge {
  display: inline-flex;
  align-items: center;

  padding: 0.75rem 1.4rem;

  border-radius: 999px;

  background: rgba(255,255,255,0.08);

  border: 1px solid rgba(255,255,255,0.12);

  backdrop-filter: blur(12px);

  color: rgba(255,255,255,0.92);

  font-family: "Inter", sans-serif;
  font-size: 0.78rem;
  font-weight: 600;

  letter-spacing: 2px;
  text-transform: uppercase;

  margin-bottom: 1.8rem;
}

.premium-heading {
  margin: 0;

  font-family: "Cormorant Garamond", serif;
  font-size: clamp(4rem, 7vw, 7rem);
  line-height: 0.92;
  font-weight: 700;

  letter-spacing: -2px;

  color: #fff;

  text-shadow:
    0 10px 30px rgba(0,0,0,0.35);
}

.premium-subtext {
  margin-top: 1.7rem;

  max-width: 540px;

  color: rgba(255,255,255,0.82);

  font-family: "Inter", sans-serif;
  font-size: 1.05rem;
  line-height: 1.8;
  font-weight: 400;
}

.premium-btn {
  margin-top: 2.4rem;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 1.15rem 2.8rem;

  border-radius: 999px;

  background: #2FA084;

  color: #fff;

  font-family: "Inter", sans-serif;
  font-size: 0.92rem;
  font-weight: 700;

  text-decoration: none;
  letter-spacing: 1.5px;
  text-transform: uppercase;

  transition: all 0.35s ease;

  box-shadow:
    0 14px 30px rgba(47,160,132,0.28);
}

.premium-btn:hover {
  transform: translateY(-4px);

  background: #38b596;

  box-shadow:
    0 18px 40px rgba(47,160,132,0.42);
}

/* DOTS */

.premium-carousel__nav {
  position: absolute;

  bottom: 2rem;
  left: 50%;

  transform: translateX(-50%);

  z-index: 10;
}

.carousel-dots {
  display: flex;
  align-items: center;
  gap: 10px;

  padding: 0.9rem 1.2rem;

  border-radius: 999px;

  background: rgba(0,0,0,0.3);

  backdrop-filter: blur(12px);

  border: 1px solid rgba(255,255,255,0.08);
}

.carousel-dot {
  width: 10px;
  height: 10px;

  border-radius: 50%;

  border: none;

  background: rgba(255,255,255,0.3);

  cursor: pointer;

  transition: all 0.3s ease;
}

.carousel-dot.is-active {
  width: 34px;

  border-radius: 30px;

  background: #2FA084;
}

/* NAV BUTTONS */

.carousel-nav-btn {
  position: absolute;
  top: 50%;

  transform: translateY(-50%);

  z-index: 10;

  width: 58px;
  height: 58px;

  border-radius: 50%;

  border: 1px solid rgba(255,255,255,0.12);

  background: rgba(255,255,255,0.08);

  backdrop-filter: blur(10px);

  color: #fff;

  display: flex;
  align-items: center;
  justify-content: center;

  cursor: pointer;

  transition: all 0.3s ease;
}

.carousel-nav-btn:hover {
  background: rgba(255,255,255,0.16);

  transform: translateY(-50%) scale(1.06);
}

.prev-btn {
  left: 24px;
}

.next-btn {
  right: 24px;
}

/* MOBILE */

@media screen and (max-width: 768px) {

  .premium-carousel {
    height: 70vh;
   
  }

  .premium-carousel__overlay {
    background:
      linear-gradient(
        180deg,
        rgba(0,0,0,0.42) 0%,
        rgba(0,0,0,0.48) 35%,
        rgba(0,0,0,0.82) 100%
      );
  }

  .premium-carousel__content {
    max-width: 100%;

    padding:
      0 1.5rem 5rem;

    height: 100%;

    justify-content: flex-end;

    align-items: center;

    text-align: center;
  }

  .premium-heading {
    font-size: 3.5rem;
    line-height: 1;
  }

  .premium-subtext {
    font-size: 0.96rem;
    line-height: 1.7;
  }

  .premium-btn {
    width: 100%;
  }

  .carousel-nav-btn {
    display: none;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', initPremiumCarousel);
initPremiumCarousel();

function initPremiumCarousel() {

  const carousel = document.querySelector('.premium-carousel');

  if (!carousel || carousel.classList.contains('initialized')) return;

  carousel.classList.add('initialized');

  const track = carousel.querySelector('.premium-carousel__track');
  const dots = carousel.querySelectorAll('.carousel-dot');
  const prevBtn = carousel.querySelector('.prev-btn');
  const nextBtn = carousel.querySelector('.next-btn');

  let autoPlay;

  const interval = 5000;

  const getSlideWidth = () => track.clientWidth;

  const getMaxScroll = () =>
    track.scrollWidth - getSlideWidth();

  function updateDots() {
    const index = Math.round(
      track.scrollLeft / getSlideWidth()
    );

    dots.forEach((dot, i) => {
      dot.classList.toggle('is-active', i === index);
    });
  }

  function scrollToSlide(index) {
    track.scrollTo({
      left: index * getSlideWidth(),
      behavior: 'smooth'
    });
  }

  function startAutoPlay() {

    clearInterval(autoPlay);

    autoPlay = setInterval(() => {

      const maxScroll = getMaxScroll();

      if (track.scrollLeft >= maxScroll - 10) {

        track.scrollTo({
          left: 0,
          behavior: 'smooth'
        });

      } else {

        track.scrollBy({
          left: getSlideWidth(),
          behavior: 'smooth'
        });

      }

    }, interval);
  }

  dots.forEach(dot => {

    dot.addEventListener('click', () => {

      const index = parseInt(dot.dataset.index);

      scrollToSlide(index);

      startAutoPlay();
    });

  });

  prevBtn.addEventListener('click', () => {

    const width = getSlideWidth();

    if (track.scrollLeft <= 10) {

      track.scrollTo({
        left: getMaxScroll(),
        behavior: 'smooth'
      });

    } else {

      track.scrollBy({
        left: -width,
        behavior: 'smooth'
      });

    }

    startAutoPlay();
  });

  nextBtn.addEventListener('click', () => {

    const width = getSlideWidth();

    if (track.scrollLeft >= getMaxScroll() - 10) {

      track.scrollTo({
        left: 0,
        behavior: 'smooth'
      });

    } else {

      track.scrollBy({
        left: width,
        behavior: 'smooth'
      });

    }

    startAutoPlay();
  });

  track.addEventListener('scroll', updateDots, {
    passive: true
  });

  carousel.addEventListener('mouseenter', () => {
    clearInterval(autoPlay);
  });

  carousel.addEventListener('mouseleave', startAutoPlay);

  window.addEventListener('resize', updateDots);

  startAutoPlay();
}
</script>