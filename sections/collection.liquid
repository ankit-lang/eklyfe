{% comment %}
  Premium collection page with animated scroll reveals and modern product cards.
{% endcomment %}

<div class="collection-page">
  <div class="collection-hero reveal-text">
    <span class="collection-eyebrow">{{ collection.products_count }} Products</span>
    <h1 class="collection-title">{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <p class="collection-description">{{ collection.description }}</p>
    {% endif %}
  </div>

  <div class="collection-grid-wrapper">
    {% if collection.products.size > 0 %}
      {% paginate collection.products by 12 %}
        <div class="collection-grid">
          {% for product in collection.products %}
            <div class="col-product-card reveal-card" style="--card-delay: {{ forloop.index0 | times: 80 }}ms">
              <a href="{{ product.url }}" class="col-product-card__image-link">
                <div class="col-product-card__media">
                  {% if product.featured_image %}
                    {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', class: 'col-product-card__img' }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'col-product-card__img placeholder' }}
                  {% endif %}
                  <div class="col-product-card__tag">
                    {{ product.metafields.custom.benefit_tag | default: 'STAMINA & VITALITY' }}
                  </div>
                </div>
              </a>
              <div class="col-product-card__body">
                {% if product.vendor != blank %}
                  <span class="col-product-card__vendor">{{ product.vendor }}</span>
                {% endif %}
                <h3 class="col-product-card__title">
                  <a href="{{ product.url }}">{{ product.title }}</a>
                </h3>
                <p class="col-product-card__description">
                  {{ product.metafields.custom.short_description | default: product.metafields.custom.product_description | default: product.description | strip_html | truncate: 120 }}
                </p>
                <div class="col-product-card__rating">
                  {% assign rating = product.metafields.reviews.rating.value | default: 4.7 %}
                  {% assign rating_count = product.metafields.reviews.rating_count | default: 294 %}
                  <span class="rating-number">{{ rating }}</span>
                  <span class="star-icons">★★★★★</span>
                  <span class="rating-count">{{ rating_count }} ratings</span>
                </div>
                <div class="col-product-card__pricing-row">
                  <div class="col-product-card__pricing">
                    {% if product.compare_at_price > product.price %}
                      <span class="price-was">{{ product.compare_at_price | money }}</span>
                    {% endif %}
                    <span class="price-now">{{ product.price | money }}</span>
                  </div>
                  {% form 'product', product %}
                    <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
                    <button type="submit" class="col-add-to-cart" {% unless product.available %}disabled{% endunless %}>
                      {% if product.available %}
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                        Add
                      {% else %}
                        Sold Out
                      {% endif %}
                    </button>
                  {% endform %}
                </div>
                <div class="col-product-card__shipping">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h3l.4 2M7 13h10l4-8H5.4"/><path d="M16 16a2 2 0 100 4 2 2 0 000-4zm-8 0a2 2 0 100 4 2 2 0 000-4z"/></svg>
                  Estimated Delivery in 2-3 Days
                </div>
                <div class="col-product-card__promo-row">
                  <span class="promo-green">+₹60 OFF on Prepaid</span>
                  <span class="promo-gray">COD Available</span>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <div class="collection-pagination reveal-text">
            {{ paginate | default_pagination }}
          </div>
        {% endif %}
      {% endpaginate %}
    {% else %}
      <div class="collection-empty-state reveal-text">
        <h2 class="empty-state-title">Great things are on the horizon</h2>
        <p class="empty-state-subtitle">Something big is brewing! Our store is in the works and will be launching soon!</p>
        <a href="{{ routes.root_url }}" class="empty-state-btn">Continue Shopping</a>
      </div>
    {% endif %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.reveal-card');
    const texts = document.querySelectorAll('.reveal-text');
    const io = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const delay = entry.target.style.getPropertyValue('--card-delay') || '0ms';
          setTimeout(() => entry.target.classList.add('is-revealed'), parseInt(delay));
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.05 });

    [...cards, ...texts].forEach(el => io.observe(el));
  });
</script>

{% stylesheet %}
  .collection-page {
    padding-bottom: 6rem;
  }

  /* ─── Hero banner ── */
  .collection-hero {
    text-align: center;
    padding: 6rem 5% 4rem;
    background: linear-gradient(160deg, #f0faf7 0%, #fff 100%);
    border-bottom: 1px solid #eee;
    margin-bottom: 4rem;
  }
  .collection-eyebrow {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 3px;
    color: #f47f20;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .collection-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    color: #1a4f44;
    letter-spacing: -2px;
    margin: 0 0 1rem;
  }
  .collection-description {
    max-width: 600px;
    margin: 0 auto;
    color: #666;
    font-size: 1.1rem;
    line-height: 1.7;
  }

  /* ─── Grid ── */
  .collection-grid-wrapper {
    padding: 0 5%;
  }
  .collection-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2.5rem;
  }

  /* ─── Reveal ── */
  .reveal-text {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal-card {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal-text.is-revealed,
  .reveal-card.is-revealed {
    opacity: 1;
    transform: none;
  }

  /* ─── Product Card ── */
  .col-product-card {
    background: #fff;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid #f0f0f0;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 580px;
  }
  .col-product-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 26px 65px rgba(15, 23, 42, 0.08);
  }
  .col-product-card__image-link {
    display: block;
    text-decoration: none;
  }
  .col-product-card__media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f8f8f8;
  }
  .col-product-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .col-product-card:hover .col-product-card__img {
    transform: scale(1.04);
  }
  .col-product-card__tag {
    position: absolute;
    bottom: 16px;
    left: 16px;
    background: rgba(17,17,17,0.9);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 999px;
    z-index: 2;
  }
  .col-product-card__body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }
  .col-product-card__vendor {
    font-size: 0.75rem;
    font-weight: 700;
    color: #111;
    text-transform: uppercase;
    letter-spacing: 0.09em;
  }
  .col-product-card__title {
    margin: 0;
    font-size: 1rem;
    font-weight: 900;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .col-product-card__title a {
    text-decoration: none;
    color: #111;
  }
  .col-product-card__description {
    margin: 0;
    color: #4b5563;
    font-size: 0.85rem;
    line-height: 1.45;
    height: 38px;
    max-height: 38px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .col-product-card__rating {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #6b7280;
    font-size: 0.8rem;
  }
  .col-product-card__rating .rating-number {
    font-weight: 900;
    color: #111;
  }
  .col-product-card__rating .star-icons {
    color: #f59e0b;
    letter-spacing: -0.08em;
  }
  .col-product-card__rating .rating-count {
    color: #6b7280;
  }
  .col-product-card__pricing-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .col-product-card__pricing {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .price-was {
    font-size: 0.8rem;
    color: #9ca3af;
    text-decoration: line-through;
  }
  .price-now {
    font-size: 1.35rem;
    font-weight: 900;
    color: #111;
  }
  .col-add-to-cart {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #111827;
    color: #fff;
    border: none;
    padding: 12px 18px;
    border-radius: 999px;
    font-weight: 800;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
    white-space: nowrap;
  }
  .col-add-to-cart:hover {
    background: #1f2937;
    transform: translateY(-1px);
  }
  .col-add-to-cart:disabled {
    background: #d1d5db;
    cursor: not-allowed;
    transform: none;
  }
  .col-product-card__shipping {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #6b7280;
    font-size: 0.8rem;
  }
  .col-product-card__shipping svg {
    width: 16px;
    height: 16px;
    color: #16a34a;
  }
  .col-product-card__promo-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: #4b5563;
    font-size: 0.78rem;
    font-weight: 700;
  }
  .promo-green {
    color: #16a34a;
  }
  .promo-gray {
    color: #6b7280;
  }

  /* ─── Pagination ── */
  .collection-pagination {
    margin-top: 4rem;
    text-align: center;
  }
  .collection-pagination .pagination {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }
  .collection-pagination a,
  .collection-pagination span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-weight: 700;
    text-decoration: none;
    color: #1a4f44;
    border: 2px solid #eee;
    transition: all 0.3s;
  }
  .collection-pagination a:hover {
    background: #1a4f44;
    color: #fff;
    border-color: #1a4f44;
  }

  @media screen and (max-width: 600px) {
    .collection-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  /* ─── Empty State ── */
  .collection-empty-state {
    text-align: center;
    padding: 5rem 2rem;
    max-width: 800px;
    margin: 0 auto;
    background: #fcfcfc;
    border-radius: 24px;
    border: 1px dashed #e0e0e0;
  }
  .empty-state-title {
    font-family: "Times New Roman", Times, serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 400;
    color: #1a4f44;
    margin: 0 0 1.5rem;
    line-height: 1.1;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .empty-state-subtitle {
    font-size: 1.1rem;
    color: #555;
    margin: 0 0 3rem;
    line-height: 1.6;
  }
  .empty-state-btn {
    display: inline-block;
    background: #1a4f44;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 16px 36px;
    border-radius: 100px;
    text-decoration: none;
    transition: transform 0.3s ease, background 0.3s ease;
  }
  .empty-state-btn:hover {
    background: #f47f20;
    transform: translateY(-3px);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}
