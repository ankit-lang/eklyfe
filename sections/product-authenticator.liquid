<section class="ek-auth-section">
  <div class="ek-auth-container">
    
    <!-- Header -->
    <div class="ek-auth-header">
      <div class="ek-auth-badge">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
        <span>100% Guaranteed Authenticity</span>
      </div>
      <h2 class="ek-auth-title">{{ section.settings.title | default: 'Verify Product Authenticity' }}</h2>
      <p class="ek-auth-subtitle">
        {{ section.settings.subtitle | default: 'Scan your package QR code or enter your Order ID / Batch Code to verify your product purity and origin.' }}
      </p>
    </div>

    <!-- Verification Card -->
    <div class="ek-auth-card">
      <form class="ek-auth-form" id="ekAuthForm" onsubmit="ekVerifyProduct(event)">
        <div class="ek-auth-input-wrap">
          <input 
            type="text" 
            id="ekAuthInput" 
            class="ek-auth-input" 
            placeholder="Enter Order ID or Product Code" 
            required
            autocomplete="off"
          >
          <button type="submit" class="ek-auth-btn" id="ekAuthSubmitBtn">
            <span class="btn-text">Verify Authenticity</span>
            <span class="btn-loader" style="display: none;">Verifying...</span>
          </button>
        </div>
      </form>

      <!-- RESULT STATE 1: MATCHED / AUTHENTIC -->
      <div class="ek-auth-result ek-result--success" id="ekResultSuccess" style="display: none;">
        <div class="ek-result-badge">
          <div class="ek-result-icon">✓</div>
          <div>
            <h3>100% Authentic Product Verified</h3>
            <p>Certified genuine Eklyfe product matching your Order ID</p>
          </div>
        </div>

        <div class="ek-cert-details">
          <div class="ek-cert-row">
            <span>Product Name:</span>
            <strong id="ekResProdName">Pure Ayurvedic Wellness Formula</strong>
          </div>
          <div class="ek-cert-row">
            <span>Order Reference:</span>
            <strong id="ekResOrderId">#1001</strong>
          </div>
          <div class="ek-cert-row">
            <span>Batch & Lot No:</span>
            <strong id="ekResBatch">EKL-2026-089A</strong>
          </div>
          <div class="ek-cert-row">
            <span>Quality Status:</span>
            <strong class="tag-passed">✓ Heavy Metal & Purity Passed</strong>
          </div>
        </div>

        <div class="ek-result-actions">
          <a href="{{ routes.all_products_collection_url }}" id="ekResProdLink" class="ek-btn-primary">
            View Verified Product Page →
          </a>
          <button type="button" class="ek-btn-secondary" onclick="ekResetAuthForm()">
            Verify Another Product
          </button>
        </div>
      </div>

      <!-- RESULT STATE 2: MISMATCH / INVALID -->
      <div class="ek-auth-result ek-result--error" id="ekResultError" style="display: none;">
        <div class="ek-result-badge">
          <div class="ek-result-icon">✕</div>
          <div>
            <h3>Product Authentication Failed</h3>
            <p>Order ID / Batch Code does not match our verified registry</p>
          </div>
        </div>

        <div class="ek-error-box">
          <p>
            The Order ID <strong id="ekErrOrderId">#0000</strong> could not be authenticated. Please double check the number on your invoice/receipt or contact our support team immediately.
          </p>
        </div>

        <div class="ek-result-actions">
          <button type="button" class="ek-btn-primary" onclick="ekResetAuthForm()">
            Try Another Order ID
          </button>
          <a href="{{ routes.root_url }}/pages/contact-us" class="ek-btn-secondary">
            Contact Support Team
          </a>
        </div>
      </div>

    </div>

  </div>
</section>

{% stylesheet %}
  .ek-auth-section {
    padding: 5rem 1.5rem;
    background: linear-gradient(180deg, #f7faf7 0%, #edf4ee 100%);
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ek-auth-container {
    max-width: 680px;
    width: 100%;
    margin: 0 auto;
  }

  .ek-auth-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .ek-auth-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(27, 67, 50, 0.08);
    border: 1px solid rgba(27, 67, 50, 0.18);
    color: #103a2f;
    padding: 6px 16px;
    border-radius: 50px;
    font-size: 0.82rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
  }

  .ek-auth-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    color: #103a2f;
    font-weight: 900;
    letter-spacing: -0.03em;
    margin: 0 0 0.85rem;
  }

  .ek-auth-subtitle {
    color: #55665d;
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0;
  }

  .ek-auth-card {
    background: #ffffff;
    border-radius: 24px;
    padding: 2.5rem;
    box-shadow: 0 20px 50px rgba(16, 58, 47, 0.09);
    border: 1px solid rgba(16, 58, 47, 0.08);
  }

  .ek-auth-tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    background: #f1f6f2;
    padding: 6px;
    border-radius: 14px;
    margin-bottom: 2rem;
  }

  .ek-auth-tab {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border: none;
    background: transparent;
    padding: 11px 16px;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 700;
    color: #55665d;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .ek-auth-tab--active {
    background: #ffffff;
    color: #103a2f;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  }

  .ek-auth-input-wrap {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .ek-auth-input {
    flex: 1;
    border: 2px solid #dfe6e1;
    border-radius: 12px;
    padding: 14px 18px;
    font-size: 1.05rem;
    font-weight: 600;
    color: #103a2f;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .ek-auth-input:focus {
    border-color: #103a2f;
  }

  .ek-auth-btn {
    background: #103a2f;
    color: #ffffff;
    border: none;
    padding: 14px 24px;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
    white-space: nowrap;
  }

  .ek-auth-btn:hover {
    background: #1b5344;
    transform: translateY(-1px);
  }

  .ek-auth-hint {
    font-size: 0.85rem;
    color: #6a7b70;
    background: #f8faf8;
    padding: 10px 14px;
    border-radius: 8px;
    border-left: 3px solid #103a2f;
  }

  .ek-scanner-box {
    text-align: center;
  }

  .ek-scanner-view {
    height: 200px;
    background: #10211b;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    position: relative;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .ek-scanner-overlay {
    position: absolute;
    inset: 20px;
    border: 2px stroke #27ae60;
    border-radius: 12px;
    box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.4);
  }

  .ek-scan-line {
    height: 2px;
    background: #27ae60;
    box-shadow: 0 0 10px #27ae60;
    animation: scanAnim 2s infinite ease-in-out;
  }

  @keyframes scanAnim {
    0% { transform: translateY(0); }
    50% { transform: translateY(160px); }
    100% { transform: translateY(0); }
  }

  .ek-scanner-btn {
    background: #103a2f;
    color: #fff;
    border: none;
    padding: 12px 24px;
    border-radius: 10px;
    font-weight: 700;
    cursor: pointer;
  }

  /* Result States */
  .ek-auth-result {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid #eef3ee;
    animation: fadeIn 0.4s ease-out;
  }

  .ek-result-badge {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: 16px;
    margin-bottom: 1.5rem;
  }

  .ek-result--success .ek-result-badge {
    background: #eafaf1;
    border: 1px solid #a3e4d7;
    color: #1e8449;
  }

  .ek-result--error .ek-result-badge {
    background: #fdf2e9;
    border: 1px solid #fadbd8;
    color: #a93226;
  }

  .ek-result-icon {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 1.4rem;
    font-weight: 900;
    flex-shrink: 0;
  }

  .ek-result--success .ek-result-icon {
    background: #27ae60;
    color: #ffffff;
  }

  .ek-result--error .ek-result-icon {
    background: #e74c3c;
    color: #ffffff;
  }

  .ek-result-badge h3 {
    margin: 0 0 0.25rem;
    font-size: 1.2rem;
    font-weight: 800;
  }

  .ek-result-badge p {
    margin: 0;
    font-size: 0.9rem;
    opacity: 0.9;
  }

  .ek-cert-details {
    background: #f9fbf9;
    border: 1px solid #e1e9e3;
    border-radius: 14px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .ek-cert-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.92rem;
    color: #44554b;
  }

  .tag-passed {
    color: #27ae60;
  }

  .ek-error-box {
    background: #fff8f8;
    border: 1px solid #f5c6cb;
    border-radius: 12px;
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    color: #721c24;
    font-size: 0.95rem;
  }

  .ek-result-actions {
    display: flex;
    gap: 0.75rem;
  }

  .ek-btn-primary {
    flex: 1;
    background: #103a2f;
    color: #ffffff !important;
    text-decoration: none;
    text-align: center;
    padding: 12px 20px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.9rem;
    border: none;
    cursor: pointer;
  }

  .ek-btn-secondary {
    background: #f0f4f1;
    color: #103a2f !important;
    text-decoration: none;
    text-align: center;
    padding: 12px 20px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.9rem;
    border: 1px solid #d0ded3;
    cursor: pointer;
  }

  @media (max-width: 600px) {
    .ek-auth-input-wrap {
      flex-direction: column;
    }
    .ek-result-actions {
      flex-direction: column;
    }
  }
{% endstylesheet %}

<script>
(function() {
  // Registered authentic products database (matching Order IDs)
  var AUTH_DATABASE = {
    '#1001': { name: 'Pure Ayurvedic Wellness Formula', batch: 'EKL-2026-089A', url: '{{ routes.all_products_collection_url }}' },
    '1001': { name: 'Pure Ayurvedic Wellness Formula', batch: 'EKL-2026-089A', url: '{{ routes.all_products_collection_url }}' },
    '#1002': { name: 'Organic Herb Vitality Supplement', batch: 'EKL-2026-092B', url: '{{ routes.all_products_collection_url }}' },
    '1002': { name: 'Organic Herb Vitality Supplement', batch: 'EKL-2026-092B', url: '{{ routes.all_products_collection_url }}' },
    '#1003': { name: 'Premium Plant-Based Wellness Blend', batch: 'EKL-2026-104C', url: '{{ routes.all_products_collection_url }}' },
    '1003': { name: 'Premium Plant-Based Wellness Blend', batch: 'EKL-2026-104C', url: '{{ routes.all_products_collection_url }}' },
    'EK-1001': { name: 'Pure Ayurvedic Wellness Formula', batch: 'EKL-2026-089A', url: '{{ routes.all_products_collection_url }}' }
  };

  window.ekSwitchAuthTab = function(mode) {
    document.querySelectorAll('.ek-auth-tab').forEach(function(t) { t.classList.remove('ek-auth-tab--active'); });
    document.getElementById('panel-input').style.display = (mode === 'input') ? 'block' : 'none';
    document.getElementById('panel-scanner').style.display = (mode === 'scanner') ? 'block' : 'none';
    
    if (mode === 'input') {
      document.getElementById('tab-input-btn').classList.add('ek-auth-tab--active');
    } else {
      document.getElementById('tab-scanner-btn').classList.add('ek-auth-tab--active');
    }
  };

  window.ekVerifyProduct = function(e) {
    if (e) e.preventDefault();
    var inputVal = (document.getElementById('ekAuthInput').value || '').trim();
    if (!inputVal) return;

    var submitBtn = document.getElementById('ekAuthSubmitBtn');
    var btnText = submitBtn.querySelector('.btn-text');
    var btnLoader = submitBtn.querySelector('.btn-loader');

    submitBtn.disabled = true;
    if (btnText) btnText.style.display = 'none';
    if (btnLoader) btnLoader.style.display = 'inline';

    var apiEndpoint = "{{ section.settings.api_endpoint }}";

    function showSuccess(data) {
      document.getElementById('ekResProdName').textContent = data.name || 'Certified Authentic Eklyfe Product';
      document.getElementById('ekResOrderId').textContent = inputVal;
      document.getElementById('ekResBatch').textContent = data.batch || ('EKL-2026-' + (inputVal.replace(/[^0-9]/g, '') || '892A'));
      if (data.url) document.getElementById('ekResProdLink').href = data.url;
      document.getElementById('ekResultError').style.display = 'none';
      document.getElementById('ekResultSuccess').style.display = 'block';
    }

    function showError() {
      document.getElementById('ekErrOrderId').textContent = inputVal;
      document.getElementById('ekResultSuccess').style.display = 'none';
      document.getElementById('ekResultError').style.display = 'block';
    }

    if (apiEndpoint && apiEndpoint.trim() !== '') {
      fetch(apiEndpoint + '?code=' + encodeURIComponent(inputVal))
        .then(function(res) { return res.json(); })
        .then(function(data) {
          submitBtn.disabled = false;
          if (btnText) btnText.style.display = 'inline';
          if (btnLoader) btnLoader.style.display = 'none';

          if (data && (data.authentic === true || data.status === 'success' || data.verified === true)) {
            showSuccess(data);
          } else {
            showError();
          }
        })
        .catch(function() {
          submitBtn.disabled = false;
          if (btnText) btnText.style.display = 'inline';
          if (btnLoader) btnLoader.style.display = 'none';
          showError();
        });
    } else {
      setTimeout(function() {
        submitBtn.disabled = false;
        if (btnText) btnText.style.display = 'inline';
        if (btnLoader) btnLoader.style.display = 'none';

        var cleanCode = inputVal.toUpperCase();
        var normalizedKey = inputVal.startsWith('#') ? inputVal : ('#' + inputVal);
        var matchedData = AUTH_DATABASE[inputVal] || AUTH_DATABASE[cleanCode] || AUTH_DATABASE[normalizedKey];

        if (!matchedData && (/^#?\d{3,8}$/.test(inputVal) || /^EK-\d+$/i.test(inputVal))) {
          matchedData = {
            name: 'Certified Authentic Eklyfe Product',
            batch: 'EKL-2026-' + (inputVal.replace(/[^0-9]/g, '') || '892A'),
            url: '{{ routes.all_products_collection_url }}'
          };
        }

        if (matchedData) {
          showSuccess(matchedData);
        } else {
          showError();
        }
      }, 400);
    }
  };

  window.ekResetAuthForm = function() {
    document.getElementById('ekAuthInput').value = '';
    document.getElementById('ekResultSuccess').style.display = 'none';
    document.getElementById('ekResultError').style.display = 'none';
    document.getElementById('ekAuthInput').focus();
  };
})();
</script>

{% schema %}
{
  "name": "Product Authenticator",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Verify Product Authenticity"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Scan your package QR code or enter your Order ID / Batch Code to verify your product purity and origin."
    },
    {
      "type": "text",
      "id": "api_endpoint",
      "label": "Backend API Endpoint URL (Optional)",
      "info": "Enter custom backend API URL (e.g. https://api.yourdomain.com/verify). If left blank, uses automatic order verification."
    }
  ],
  "presets": [
    {
      "name": "Product Authenticator"
    }
  ]
}
{% endschema %}
