    color: #888;
    padding: 10px 16px;
    border-radius: 10px;
    transition: all 0.3s ease;
    display: block;
  }
  .faq-nav a:hover, .faq-nav a.active {
    color: #1a4f44;
    background: #f0faf7;
    padding-left: 24px;
  }

  /* FAQ Categories & Items */
  .faq-category {
    margin-bottom: 4rem;
  }
  .faq-category h3 {
    font-size: 2rem;
    font-weight: 800;
    color: #1a4f44;
