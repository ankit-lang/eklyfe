<header class="header" id="site-header">
  <!-- Hamburger (mobile only) -->
  <button class="mobile-menu-toggle" id="mobile-menu-btn" aria-label="Open menu" aria-expanded="false">
    <span class="burger-bar"></span>
    <span class="burger-bar"></span>
    <span class="burger-bar"></span>
  </button>

  <div class="header__logo">
    {% if section.settings.logo != blank %}
      <a href="{{ routes.root_url }}">
        {{ section.settings.logo | image_url: width: section.settings.logo_width | image_tag: alt: shop.name }}
      </a>
    {% else %}
      <h2 class="header__title">
        {{ shop.name | link_to: routes.root_url }}
      </h2>
    {% endif %}
  </div>

  <!-- Desktop nav + search -->
  <div class="header__nav-wrapper" id="header-nav">
    <nav class="header__menu">
      {% if section.settings.menu.links != blank %}
        {% for link in section.settings.menu.links %}
          {% if link.links != blank %}
            <div class="header__dropdown-wrapper">
              <a href="{{ link.url }}" class="header__menu-link header__menu-link--has-dropdown" aria-haspopup="true" aria-expanded="false">
                {{ link.title }}
                <svg class="header__caret" width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              <ul class="header__dropdown">
                {% for child_link in link.links %}
                  <li class="header__dropdown-item">
                    <a href="{{ child_link.url }}" class="header__dropdown-link">
                      {{ child_link.title }}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% else %}
            <a href="{{ link.url }}" class="header__menu-link">{{ link.title }}</a>
          {% endif %}
        {% endfor %}
      {% else %}
        <a href="{{ routes.root_url }}" class="header__menu-link">Home</a>
        <div class="header__dropdown-wrapper">
          <a href="#" class="header__menu-link header__menu-link--has-dropdown" aria-haspopup="true" aria-expanded="false">
            Shop By Solution
            <svg class="header__caret" width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <ul class="header__dropdown">
            <li class="header__dropdown-item"><a href="/collections/general-awareness" class="header__dropdown-link">General Awareness</a></li>
            <li class="header__dropdown-item"><a href="/collections/sexual-wellness" class="header__dropdown-link">Sexual Wellness</a></li>
            <li class="header__dropdown-item"><a href="/collections/skin-wellness" class="header__dropdown-link">Skin Wellness</a></li>
            <li class="header__dropdown-item"><a href="/collections/weight-management" class="header__dropdown-link">Weight Management</a></li>
          </ul>
        </div>
        <div class="header__dropdown-wrapper">
          <a href="/collections/all" class="header__menu-link header__menu-link--has-dropdown" aria-haspopup="true" aria-expanded="false">
            Our Products
            <svg class="header__caret" width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <ul class="header__dropdown">
            <li class="header__dropdown-item"><a href="/collections/top-seller" class="header__dropdown-link">Best Sellers</a></li>
            <li class="header__dropdown-item"><a href="/collections/all" class="header__dropdown-link">View All Products</a></li>
          </ul>
        </div>
        <a href="/collections/top-seller" class="header__menu-link">Best Selling</a>
        <a href="/pages/about-us" class="header__menu-link">About Us</a>
        <a href="/pages/faq" class="header__menu-link">FAQs</a>
      {% endif %}
    </nav>

    <div class="header__search">
      <form action="{{ routes.search_url }}" method="get" class="search-form" role="search">
        <input type="text" name="q" placeholder="Search products…" class="search-form__input" aria-label="Search">
        <button type="submit" class="search-form__submit" aria-label="Submit search">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
      </form>
    </div>
  </div>

  <div class="header__icons">
    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ section.settings.customer_account_menu }}">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}

    <a href="{{ routes.cart_url }}" class="header__cart-link" aria-label="Cart">
      {{ 'icon-cart.svg' | inline_asset_content }}
      {% if cart.item_count > 0 %}
        <span class="cart-count">{{ cart.item_count }}</span>
      {% endif %}
    </a>
  </div>
</header>

<!-- Mobile backdrop overlay -->
<div class="mobile-backdrop" id="mobile-backdrop"></div>

<script>
  (function () {
    var btn = document.getElementById('mobile-menu-btn');
    var nav = document.getElementById('header-nav');
    var backdrop = document.getElementById('mobile-backdrop');

    if (!btn || !nav) return;

    function openMenu() {
      nav.classList.add('is-open');
      if (backdrop) backdrop.classList.add('is-visible');
      btn.setAttribute('aria-expanded', 'true');
      btn.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      nav.classList.remove('is-open');
      if (backdrop) backdrop.classList.remove('is-visible');
      btn.setAttribute('aria-expanded', 'false');
      btn.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      nav.classList.contains('is-open') ? closeMenu() : openMenu();
    });

    if (backdrop) backdrop.addEventListener('click', closeMenu);

    // Close on nav link click, except for dropdown toggles on mobile
    nav.querySelectorAll('a').forEach(function (link) {
      if (!link.classList.contains('header__menu-link--has-dropdown')) {
        link.addEventListener('click', closeMenu);
      } else {
        link.addEventListener('click', function(e) {
          if (window.innerWidth <= 990) {
            e.preventDefault();
            this.closest('.header__dropdown-wrapper').classList.toggle('is-active');
          }
        });
      }
    });
  })();
</script>

{% stylesheet %}
  /* ── Header base ── */
  .header {
    position: sticky;
    top: 0;
    z-index: 1005; /* Above announcement bar */
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0 5%;
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 rgba(0,0,0,0.08);
  }

  /* ── Logo ── */
  .header__logo img {
    max-height: 56px;
    width: auto;
    transition: transform 0.3s ease;
  }
  .header__logo:hover img { transform: scale(1.04); }
  .header__title a {
    text-decoration: none;
    color: #1a4f44;
    font-size: 24px;
    font-weight: 900;
    letter-spacing: -0.5px;
  }

  /* ── Desktop nav wrapper ── */
  .header__nav-wrapper {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  /* ── Nav links & Dropdowns ── */
  .header__menu {
    display: flex;
    align-items: center;
    gap: 2.2rem;
    margin: 0 0 0 2rem;
    list-style: none;
    padding: 0;
  }
  .header__menu-link {
    text-decoration: none;
    color: #444;
    font-weight: 600;
    font-size: 15px;
    position: relative;
    padding: 28px 0; /* Expanded padding for easier hover */
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    transition: color 0.3s ease;
  }
  .header__menu-link::after {
    content: '';
    position: absolute;
    bottom: 22px; left: 0;
    width: 0; height: 2px;
    background: #1a4f44;
    border-radius: 1px;
    transition: width 0.3s ease;
  }
  .header__dropdown-wrapper:hover .header__menu-link,
  .header__menu-link:hover { color: #1a4f44; }
  .header__menu-link:hover::after { width: 100%; }

  .header__caret {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0.7;
  }
  .header__dropdown-wrapper:hover .header__caret {
    transform: rotate(180deg);
    opacity: 1;
  }

  /* Dropdown Menu */
  .header__dropdown-wrapper {
    position: relative;
  }
  .header__dropdown {
    position: absolute;
    top: 100%;
    left: -15px;
    background: #ffffff;
    min-width: 240px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.08);
    border: 1px solid rgba(0,0,0,0.04);
    border-radius: 12px;
    padding: 10px 0;
    list-style: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 100;
  }
  .header__dropdown-wrapper:hover .header__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .header__dropdown-item {
    margin: 0;
  }
  .header__dropdown-link {
    display: block;
    padding: 12px 24px;
    color: #444;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: all 0.2s;
  }
  .header__dropdown-link:hover {
    background: #f4f9f7;
    color: #1a4f44;
    padding-left: 28px; /* Smooth slide right on hover */
  }

  /* ── Search ── */
  .header__search {
    flex: 1;
    max-width: 420px;
  }
  .search-form {
    display: flex;
    align-items: center;
    background: #f4f6f5;
    border: 1.5px solid transparent;
    border-radius: 100px;
    overflow: hidden;
    transition: all 0.3s;
  }
  .search-form:focus-within {
    background: #fff;
    border-color: #1a4f44;
    box-shadow: 0 0 0 3px rgba(26,79,68,0.1);
  }
  .search-form__input {
    flex: 1;
    padding: 10px 18px;
    border: none;
    outline: none;
    background: transparent;
    font-size: 14px;
    color: #333;
  }
  .search-form__submit {
    background: none;
    border: none;
    padding: 10px 16px;
    cursor: pointer;
    color: #1a4f44;
    display: flex;
    align-items: center;
    transition: transform 0.2s;
  }
  .search-form__submit:hover { transform: scale(1.1); }

  /* ── Icons ── */
  .header__icons {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-shrink: 0;
  }
  .header__icons a,
  .header__icons shopify-account {
    position: relative;
    color: #1a4f44;
    display: flex;
    align-items: center;
    transition: transform 0.2s;
  }
  .header__icons a:hover { transform: translateY(-2px); }
  .header__icons svg { width: 24px; height: 24px; }
  .cart-count {
    position: absolute;
    top: -7px; right: -9px;
    background: #f47f20;
    color: #fff;
    font-size: 10px;
    font-weight: 800;
    border-radius: 50%;
    width: 18px; height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(244,127,32,0.4);
    animation: bounceIn 0.4s cubic-bezier(0.175,0.885,0.32,1.275) both;
  }
  @keyframes bounceIn {
    0% { transform: scale(0); }
    60% { transform: scale(1.3); }
    100% { transform: scale(1); }
  }

  /* ── Hamburger button ── */
  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0;
    border-radius: 8px;
    flex-shrink: 0;
    transition: background 0.2s;
  }
  .mobile-menu-toggle:hover { background: rgba(0,0,0,0.05); }
  .burger-bar {
    display: block;
    width: 22px;
    height: 2px;
    background: #1a4f44;
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
    transform-origin: center;
  }
  /* Hamburger → X animation */
  .mobile-menu-toggle.is-open .burger-bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .mobile-menu-toggle.is-open .burger-bar:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .mobile-menu-toggle.is-open .burger-bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ── Backdrop ── */
  .mobile-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.45);
    z-index: 999;
    opacity: 0;
    transition: opacity 0.3s;
    -webkit-tap-highlight-color: transparent;
  }
  .mobile-backdrop.is-visible {
    display: block;
    opacity: 1;
  }

  /* ── MOBILE STYLES ── */
  @media screen and (max-width: 990px) {
    .mobile-menu-toggle {
      display: flex;
    }

    .header__nav-wrapper {
      /* Full-width slide-down drawer */
      position: fixed;
      top: 80px;
      left: 0;
      right: 0;
      width: 100%;
      max-height: 0;
      overflow: hidden;
      background: #ffffff;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0;
      box-shadow: 0 12px 40px rgba(0,0,0,0.15);
      z-index: 1000;
      transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1), padding 0.4s ease;
    }
    .header__nav-wrapper.is-open {
      max-height: 75vh;
      overflow-y: auto;
      padding: 1.5rem 5% 2.5rem;
    }

    .header__menu {
      flex-direction: column;
      align-items: flex-start;
      margin: 0 0 1.5rem 0;
      gap: 0;
      width: 100%;
    }
    .header__menu a {
      display: block;
      width: 100%;
      padding: 16px 0;
      font-size: 17px;
      font-weight: 700;
      color: #111;
      border-bottom: 1px solid #f0f0f0;
    }
    .header__menu a:last-child { border-bottom: none; }
    .header__menu a::after { display: none; }
    .header__menu a:hover { color: #1a4f44; }
    
    .header__dropdown-wrapper { width: 100%; }
    
    .header__menu-link--has-dropdown {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    
    .header__dropdown {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      border: none;
      border-bottom: 1px solid #f0f0f0;
      padding: 0 0 10px 16px;
      margin: 0;
      display: none;
    }
    
    .header__dropdown-wrapper.is-active .header__dropdown {
      display: block;
      border-bottom: none;
    }
    
    .header__dropdown-wrapper.is-active .header__caret {
      transform: rotate(180deg);
    }
    
    .header__dropdown-link {
      font-size: 15px !important;
      font-weight: 500 !important;
      border-bottom: none !important;
      padding: 12px 0 !important;
    }

    .header__search {
      max-width: 100%;
      width: 100%;
    }
  }

  @media screen and (max-width: 480px) {
    .header { padding: 0 4%; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 250,
      "step": 10,
      "default": 100,
      "unit": "px",
      "label": "Custom logo width"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
