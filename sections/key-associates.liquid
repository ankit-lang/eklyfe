{% comment %}
  PREMIUM KEY ASSOCIATES SECTION
  Luxury editorial wellness UI with:
  - Glassmorphism
  - GSAP animations
  - Premium gradients
  - Floating glow effects
  - Editorial layout
  - Luxury typography
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>

<div class="premium-associates">

  <div class="premium-bg-orb orb-1"></div>
  <div class="premium-bg-orb orb-2"></div>

  <section class="premium-hero">
    <span class="premium-tag">
      {{ 'pages.key_associates.hero_label' | t }}
    </span>

    <h1>
      {{ 'pages.key_associates.hero_title' | t }}
    </h1>

    <p>
      {{ 'pages.key_associates.hero_subtitle' | t }}
    </p>
  </section>

  <div class="premium-profiles">

    <!-- ESHA -->
    <article class="premium-card">

      <div class="premium-image-wrapper">

        <div class="premium-floating-badge">
          12+ Years Experience
        </div>

        {% if section.settings.photo_esha != blank %}
          {{
            section.settings.photo_esha
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              class: 'premium-image',
              alt: 'Dt. Esha Sharma'
          }}
        {% else %}
          <div class="premium-placeholder">
            <img src="/assets/esha.jpeg" />
          </div>
        {% endif %}
      </div>

      <div class="premium-content">

        <span class="premium-name">
          {{ 'pages.key_associates.esha_name' | t }}
        </span>

        <h2>
          {{ 'pages.key_associates.esha_about_heading' | t }}
        </h2>

        <p>
          {{ 'pages.key_associates.esha_about_copy' | t }}
        </p>

        <p>
          {{ 'pages.key_associates.esha_focus_copy' | t }}
        </p>

        <div class="premium-divider"></div>

        <h3>
          {{ 'pages.key_associates.esha_association_heading' | t }}
        </h3>

        <blockquote>
          {{ 'pages.key_associates.esha_association_quote' | t }}
        </blockquote>

        <div class="premium-feature">
          <span>✦</span>
          <p>{{ 'pages.key_associates.first_consultation' | t }}</p>
        </div>

        <p class="premium-consultation">
          {{ 'pages.key_associates.esha_consultation_copy' | t }}
        </p>

      </div>
    </article>

    <!-- ANKITA -->
    <article class="premium-card reverse">

      <div class="premium-image-wrapper">

        <div class="premium-floating-badge">
          Functional Wellness
        </div>

        {% if section.settings.photo_ankita != blank %}
                   <img src="/assets/ankita.jpeg" />
        {% else %}
          <div class="premium-placeholder">
                       <img src="/assets/ankita.jpeg" />
          </div>
        {% endif %}
      </div>

      <div class="premium-content">

        <span class="premium-name">
          {{ 'pages.key_associates.ankita_name' | t }}
        </span>

        <h2>
          {{ 'pages.key_associates.ankita_about_heading' | t }}
        </h2>

        <p>
          {{ 'pages.key_associates.ankita_about_copy' | t }}
        </p>

        <p>
          {{ 'pages.key_associates.ankita_philosophy_copy' | t }}
        </p>

        <div class="premium-divider"></div>

        <h3>
          {{ 'pages.key_associates.ankita_association_heading' | t }}
        </h3>

        <blockquote>
          {{ 'pages.key_associates.ankita_association_quote' | t }}
        </blockquote>

        <div class="premium-feature">
          <span>✦</span>
          <p>{{ 'pages.key_associates.first_consultation' | t }}</p>
        </div>

        <p class="premium-consultation">
          {{ 'pages.key_associates.ankita_consultation_copy' | t }}
        </p>

      </div>
    </article>

  </div>

  <!-- CTA -->
  <section class="premium-cta">

    <div class="premium-cta-content">
      <span class="premium-tag">
        Wellness Begins Here
      </span>

      <h2>
        {{ 'pages.key_associates.page_cta_title' | t }}
      </h2>

      <p>
        {{ 'pages.key_associates.page_cta_copy' | t }}
      </p>

      <p class="premium-note">
        {{ 'pages.key_associates.page_cta_note' | t }}
      </p>
    </div>

    <a href="/pages/contact-us" class="premium-button">
      {{ 'pages.key_associates.cta_button' | t }}
    </a>

  </section>

</div>

<style>

  .premium-associates * {
    box-sizing: border-box;
  }

  .premium-associates {
    position: relative;
    overflow: hidden;
    padding: 8rem 5%;
    background:
      radial-gradient(circle at top left, rgba(244,127,32,0.15), transparent 25%),
      radial-gradient(circle at bottom right, rgba(15,47,34,0.12), transparent 30%),
      #f8f5ef;

    font-family: 'Inter', sans-serif;
  }

  .premium-bg-orb {
    position: absolute;
    border-radius: 999px;
    filter: blur(100px);
    z-index: 0;
    opacity: .6;
  }

  .orb-1 {
    width: 300px;
    height: 300px;
    background: rgba(244,127,32,0.18);
    top: 5%;
    left: -100px;
  }

  .orb-2 {
    width: 350px;
    height: 350px;
    background: rgba(15,47,34,0.12);
    right: -120px;
    bottom: 10%;
  }

  .premium-hero {
    position: relative;
    z-index: 2;
    max-width: 950px;
    margin: 0 auto 6rem;
    text-align: center;
  }

  .premium-tag {
    display: inline-flex;
    padding: .7rem 1.2rem;
    border-radius: 999px;
    background: rgba(255,255,255,.65);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,.4);
    color: #8a602c;
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .premium-hero h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(4rem, 7vw, 7rem);
    line-height: .95;
    margin: 2rem auto 1.5rem;
    color: #2FA084;
    max-width: 10ch;
    font-weight: 600;
  }

  .premium-hero p {
    max-width: 760px;
    margin: 0 auto;
    font-size: 1.15rem;
    line-height: 2;
    color: #46534d;
  }

  .premium-profiles {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 5rem;
  }

  .premium-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;

    padding: 2rem;

    background: rgba(255,255,255,.55);

    backdrop-filter: blur(24px);

    border: 1px solid rgba(255,255,255,.4);

    border-radius: 36px;

    box-shadow:
      0 10px 40px rgba(0,0,0,.04),
      inset 0 1px 0 rgba(255,255,255,.5);

    transition:
      transform .7s cubic-bezier(.16,1,.3,1),
      box-shadow .7s ease;
  }

  .premium-card:hover {
    transform: translateY(-10px);
    box-shadow:
      0 30px 90px rgba(47,160,132,.12);
  }

  .premium-card.reverse .premium-image-wrapper {
    order: 2;
  }

  .premium-image-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: 30px;
  }

  .premium-image {
    width: 100%;
    height: 700px;
    object-fit: cover;
    border-radius: 30px;
    transition: transform 1.2s ease;
    display: block;
  }

  .premium-card:hover .premium-image {
    transform: scale(1.06);
  }

  .premium-floating-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    z-index: 5;

    padding: .8rem 1.1rem;

    background: rgba(255,255,255,.65);

    backdrop-filter: blur(14px);

    border-radius: 999px;

    font-size: .8rem;
    font-weight: 700;
    color: #2FA084;
  }

  .premium-placeholder {
    height: 700px;
    display: grid;
    place-items: center;
    border-radius: 30px;
    border: 2px dashed rgba(47,160,132,.15);
    background: rgba(255,255,255,.5);
    color: #555;
    font-weight: 600;
  }

  .premium-content {
    padding: 1rem;
  }

  .premium-name {
    display: inline-block;
    margin-bottom: 1rem;
    color: #b8722d;
    letter-spacing: .2em;
    text-transform: uppercase;
    font-size: .8rem;
    font-weight: 700;
  }

  .premium-content h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.5rem, 3vw, 4rem);
    line-height: 1;
    color: #2FA084;
    margin-bottom: 1.5rem;
    font-weight: 600;
  }

  .premium-content h3 {
    margin-bottom: 1rem;
    color: #2FA084;
    font-size: 1.1rem;
  }

  .premium-content p {
    color: #4a5551;
    line-height: 2;
    font-size: 1rem;
    margin-bottom: 1.3rem;
  }

  .premium-divider {
    width: 80px;
    height: 1px;
    background: linear-gradient(to right, #f47f20, transparent);
    margin: 2rem 0;
  }

  .premium-content blockquote {
    margin: 0;
    padding: 2rem;
    border-radius: 24px;
    background: rgba(255,255,255,.45);
    border: 1px solid rgba(255,255,255,.4);
    font-style: italic;
    line-height: 2;
    color: #3f4c47;
  }

  .premium-feature {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    align-items: flex-start;
  }

  .premium-feature span {
    color: #f47f20;
    font-size: 1.4rem;
  }

  .premium-consultation {
    font-weight: 600;
    color: #2FA084;
  }

  .premium-cta {
    position: relative;
    z-index: 2;

    margin-top: 6rem;

    padding: 4rem;

    border-radius: 36px;

    background:
      linear-gradient(
        135deg,
        #2FA084,
        #247363
      );

    overflow: hidden;

    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: center;
  }

  .premium-cta::before {
    content: '';
    position: absolute;
    width: 500px;
    height: 500px;
    background: rgba(244,127,32,.12);
    border-radius: 999px;
    top: -250px;
    right: -200px;
    filter: blur(80px);
  }

  .premium-cta-content {
    position: relative;
    z-index: 2;
    max-width: 720px;
  }

  .premium-cta h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(3rem, 5vw, 5rem);
    line-height: 1;
    margin: 1.5rem 0;
    color: white;
  }

  .premium-cta p {
    color: rgba(255,255,255,.75);
    line-height: 2;
  }

  .premium-note {
    margin-top: 1.5rem;
    font-weight: 600;
  }

  .premium-button {
    position: relative;
    z-index: 2;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 1.2rem 2rem;

    border-radius: 999px;

    background: linear-gradient(
      135deg,
      #f47f20,
      #ff9b47
    );

    color: white;
    text-decoration: none;

    font-weight: 700;

    transition:
      transform .4s ease,
      box-shadow .4s ease;
  }

  .premium-button:hover {
    transform: translateY(-4px) scale(1.03);

    box-shadow:
      0 15px 40px rgba(244,127,32,.35);
  }

  @media(max-width: 1024px) {

    .premium-card,
    .premium-card.reverse {
      grid-template-columns: 1fr;
    }

    .premium-card.reverse .premium-image-wrapper {
      order: 0;
    }

    .premium-image,
    .premium-placeholder {
      height: 500px;
    }

    .premium-cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media(max-width: 768px) {

    .premium-associates {
      padding: 5rem 4%;
    }

    .premium-card {
      padding: 1rem;
      border-radius: 24px;
    }

    .premium-image,
    .premium-placeholder {
      height: 420px;
      border-radius: 22px;
    }

    .premium-hero h1 {
      font-size: 3.5rem;
    }

    .premium-content h2 {
      font-size: 2.5rem;
    }

    .premium-cta {
      padding: 2rem;
      border-radius: 24px;
    }

    .premium-cta h2 {
      font-size: 2.8rem;
    }

    .premium-button {
      width: 100%;
    }
  }

</style>

<script>

  gsap.registerPlugin(ScrollTrigger);

  gsap.from(".premium-hero", {
    opacity: 0,
    y: 60,
    duration: 1.2,
    ease: "power4.out"
  });

  gsap.utils.toArray(".premium-card").forEach((card, index) => {

    gsap.from(card, {
      opacity: 0,
      y: 120,
      duration: 1.4,
      ease: "power4.out",
      delay: index * 0.1,

      scrollTrigger: {
        trigger: card,
        start: "top 85%",
      }
    });

  });

  gsap.from(".premium-cta", {
    opacity: 0,
    y: 80,
    duration: 1.3,
    ease: "power4.out",

    scrollTrigger: {
      trigger: ".premium-cta",
      start: "top 85%"
    }
  });

</script>

{% schema %}
{
  "name": "Premium Key Associates",
  "settings": [
    {
      "type": "image_picker",
      "id": "photo_esha",
      "label": "Dt. Esha Sharma Photo"
    },
    {
      "type": "image_picker",
      "id": "photo_ankita",
      "label": "Dr. Ankita Jain Photo"
    }
  ],
  "presets": [
    {
      "name": "Premium Key Associates"
    }
  ]
}
{% endschema %}