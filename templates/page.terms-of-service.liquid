<!DOCTYPE html>
<html lang="{{ shop.locale }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page.title }} — {{ shop.name }}</title>
  <meta name="description" content="{{ page.description | default: shop.description }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {{ content_for_header }}
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            display: ['"Playfair Display"', 'serif'],
            body: ['"DM Sans"', 'sans-serif'],
          },
          colors: {
            cream: '#F9F5EE',
            green: { DEFAULT: '#2D5016', light: '#3a6b1e', sage: '#6B8F4E' },
            gold: { DEFAULT: '#C8A96E', light: '#dfc08a' },
            dark: '#1A1A1A',
            muted: '#5C5C5C',
            border: '#DDD8CC',
          }
        }
      }
    }
  </script>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html { font-family: 'DM Sans', sans-serif; }
    body { background: #fff; color: #1A1A1A; }
    .policy-hero { position: relative; min-height: 40vh; display: flex; align-items: center; background: linear-gradient(135deg, #C8A96E 0%, #dfc08a 100%); overflow: hidden; }
    .policy-hero::before { content: ''; position: absolute; top: -50%; right: -50%; width: 200%; height: 200%; background: radial-gradient(circle, rgba(45,80,22,0.1) 0%, transparent 70%); animation: rotate 20s linear infinite; }
    @keyframes rotate { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .policy-content { max-width: 1000px; margin: 0 auto; padding: 4rem 2rem; }
    .policy-content h1 { font-family: 'Playfair Display', serif; font-size: 3rem; font-weight: 700; color: #1A1A1A; margin-bottom: 2rem; text-align: center; }
    .policy-content .intro { font-size: 1.25rem; color: #5C5C5C; margin-bottom: 3rem; text-align: center; max-width: 600px; margin-left: auto; margin-right: auto; }
    .policy-section { background: #f9f5ee; border: 1px solid #ddd8cc; border-radius: 1rem; padding: 3rem; margin-bottom: 2rem; }
    .policy-section h2 { font-family: 'Playfair Display', serif; font-size: 2rem; color: #2D5016; margin-bottom: 1.5rem; }
    .policy-section p, .policy-section ul { margin-bottom: 1rem; line-height: 1.6; }
    .policy-section ul { list-style: none; padding: 0; }
    .policy-section li { margin-bottom: 0.5rem; padding-left: 1.5rem; position: relative; }
    .policy-section li::before { content: '•'; position: absolute; left: 0; color: #C8A96E; font-weight: bold; }
    .highlight { background: #2D5016; color: #fff; padding: 0.5rem 1rem; border-radius: 0.5rem; display: inline-block; margin-bottom: 1rem; }
    @media (max-width: 768px) { .policy-hero { min-height: 30vh; } .policy-content h1 { font-size: 2rem; } }
  </style>
</head>
<body>
 

  <main>
    <section class="policy-hero">
      <div class="container mx-auto px-4">
        <div class="text-center">
          <h1 class="text-4xl md:text-6xl font-bold text-dark mb-4">Terms of Service</h1>
          <p class="text-lg text-muted max-w-2xl mx-auto">Please read these terms carefully before using our services.</p>
        </div>
      </div>
    </section>

    <section class="policy-content">
      <div class="policy-section">
        <h2>Product Disclaimer</h2>
        <p>These products are supplements, not medicines. They are not intended to diagnose, treat, cure, or prevent any disease.</p>

        <h2>Medical Advice</h2>
        <p>Always consult a qualified healthcare professional before use.</p>

        <h2>Individual Results</h2>
        <p>Results may vary between individuals.</p>

        <h2>Liability</h2>
        <p>eklyfe / Agada Pharmacy Private Limited is not liable for misuse of products.</p>

        <h2>Content Purpose</h2>
        <p>All content on this website is for informational purposes only.</p>

        <h2>Governing Law</h2>
        <p>Governing law: Laws of India | Jurisdiction: Gurgaon, Haryana.</p>

        <p><em>Note: This is a summary of our terms of service. For the full legal document, please consult our complete Terms of Service generated by Shopify and customized with our company details.</em></p>
      </div>
    </section>
  </main>


  <script>
    gsap.registerPlugin(ScrollTrigger);
    gsap.from('.policy-hero h1', { opacity: 0, y: 50, duration: 1, ease: 'power3.out' });
    gsap.from('.policy-hero p', { opacity: 0, y: 30, duration: 1, delay: 0.2, ease: 'power3.out' });
    gsap.from('.policy-section', { opacity: 0, y: 50, duration: 1, ease: 'power3.out', scrollTrigger: { trigger: '.policy-section', start: 'top 90%' } });
  </script>
</body>
</html>